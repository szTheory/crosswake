<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Offline Study</title>
    <link rel="stylesheet" href="/css/tokens.css" />
    <!-- Inline styles for the study island — consumes semantic tokens from tokens.css -->
    <style>
      body {
        font-family: var(--cw-font-body);
        background-color: var(--cw-surface-default);
        color: var(--cw-text-default);
        margin: 0;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      #flashcard-container {
        background: var(--cw-surface-inset);
        border-radius: var(--cw-radius-md);
        /* theme-adaptive elevation: tints with --cw-text-default so it lightens on dark surfaces */
        box-shadow: 0 4px 6px -1px color-mix(in srgb, var(--cw-text-default) 10%, transparent);
        padding: 2rem;
        margin-bottom: 2rem;
        width: 100%;
        max-width: 24rem;
        text-align: center;
        min-height: 12rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
      }
      .card-front, .card-back {
        width: 100%;
      }
      .card-back {
        display: none;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--cw-border-default);
        color: var(--cw-text-muted);
        font-size: 1.25rem;
      }
      #controls {
        display: flex;
        gap: 1rem;
      }
      button {
        padding: 0.75rem 1.5rem;
        border-radius: var(--cw-radius-sm);
        border: 2px solid transparent;
        font-weight: bold;
        cursor: pointer;
      }
      .btn-primary { background: var(--cw-action-bg); color: var(--cw-action-fg); }
      /*
        D-02 neutral secondary: Hard is a scheduling signal, not an error.
        Uses --cw-border-default (neutral) instead of --cw-status-error (rust).
        Passes AA contrast in light + dark with no color-only signaling.
        Render-verified light + dark (108-RENDER-VERIFY.md).
      */
      .btn-secondary { background: transparent; color: var(--cw-text-default); border-color: var(--cw-border-default); }
      #status {
        margin-top: 2rem;
        font-size: var(--cw-text-scale-sm);
        color: var(--cw-text-muted);
      }
    </style>
  </head>
  <body
    data-storage-budget={@island.storage_budget}
    data-reserve-for-journal={@island.reserve_for_journal}
    data-eviction-policy={@island.eviction}
  >
    <h1>Offline Study Island</h1>

    <div id="flashcard-container">
      Loading flashcards...
    </div>

    <div id="controls">
      <button id="btn-flip" class="btn-primary">Flip Card</button>
      <button id="btn-good" class="btn-primary" style="display: none;">Good</button>
      <button id="btn-hard" class="btn-secondary" style="display: none;">Hard</button>
    </div>

    <div id="status" aria-live="polite" role="status" aria-atomic="true"></div>

    <script type="module" src="/offline_study.js"></script>
  </body>
</html>
