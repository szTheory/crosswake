<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@page_title}</title>
    <link rel="stylesheet" href="/crosswake/tokens.css" />
    <!-- Inline styles for the study island — consumes semantic tokens from tokens.css -->
    <style>
      body {
        font-family: var(--cw-font-body);
        background-color: var(--cw-surface-default);
        color: var(--cw-text-default);
        margin: 0;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      #flashcard-container {
        background: var(--cw-surface-inset);
        border-radius: var(--cw-radius-md);
        /* theme-adaptive elevation: tints with --cw-text-default so it lightens on dark surfaces */
        box-shadow: 0 4px 6px -1px color-mix(in srgb, var(--cw-text-default) 10%, transparent);
        padding: 2rem;
        margin-bottom: 2rem;
        width: 100%;
        max-width: 24rem;
        text-align: center;
        min-height: 12rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
      }
      .card-front, .card-back {
        width: 100%;
      }
      .card-back {
        display: none;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--cw-border-default);
        color: var(--cw-text-muted);
        font-size: 1.25rem;
      }
      #controls {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      button {
        padding: 0.75rem 1.5rem;
        border-radius: var(--cw-radius-sm);
        border: 2px solid transparent;
        font-weight: 600;
        cursor: pointer;
        min-width: 44px;
        min-height: 44px;
      }
      .btn-primary { background: var(--cw-action-bg); color: var(--cw-action-fg); }
      /*
        D-02 neutral secondary: Hard is a scheduling signal, not an error.
        Uses --cw-border-default (neutral) instead of --cw-status-error (rust).
        Passes AA contrast in light + dark with no color-only signaling.
        Render-verified light + dark (108-RENDER-VERIFY.md).
      */
      .btn-secondary { background: transparent; color: var(--cw-text-default); border-color: var(--cw-border-default); }
      #crosswake-study-status {
        box-sizing: border-box;
        width: 100%;
        max-width: 24rem;
        margin: 1rem 0;
        padding: 16px;
        background: var(--cw-surface-raised);
        border: 1px solid var(--cw-border-default);
        border-radius: var(--cw-radius-md);
        color: var(--cw-text-default);
      }
      .study-status-content {
        display: flex;
        gap: 4px;
        align-items: flex-start;
      }
      .study-status-icon {
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        margin-top: 2px;
        color: var(--cw-status-info);
      }
      #crosswake-study-status[data-state="needs_attention"] .study-status-icon,
      #crosswake-study-status[data-state="sync_paused"] .study-status-icon {
        color: var(--cw-status-warning);
      }
      .study-status-copy { min-width: 0; }
      #crosswake-study-status-label {
        display: block;
        font: 600 18px/28px var(--cw-font-body);
      }
      #crosswake-study-status-message {
        margin: 0;
        font: 400 16px/24px var(--cw-font-body);
      }
      #crosswake-study-status-indicator {
        width: 16px;
        height: 16px;
        margin-top: 4px;
        flex: 0 0 16px;
        border: 2px solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        color: var(--cw-status-info);
        animation: study-status-spin 0.9s linear infinite;
      }
      #crosswake-review-saved-answers {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        min-height: 44px;
        margin-top: 8px;
        padding: 0 16px;
        border-radius: var(--cw-radius-sm);
        background: var(--cw-action-bg);
        color: var(--cw-action-fg);
        font: 600 18px/28px var(--cw-font-body);
        text-decoration: none;
      }
      #card-position {
        margin: 0 0 8px;
        color: var(--cw-text-muted);
        font: 600 14px/20px var(--cw-font-display);
      }
      @keyframes study-status-spin { to { transform: rotate(360deg); } }
      @media (prefers-reduced-motion: reduce) {
        #crosswake-study-status-indicator { animation: none; }
      }
    </style>
  </head>
  <body
    data-storage-budget={@island.storage_budget}
    data-reserve-for-journal={@island.reserve_for_journal}
    data-eviction-policy={@island.eviction}
  >
    <h1>Offline Study Island</h1>

    <div id="crosswake-study-status" data-state="sync_paused" role="status" aria-live="polite" aria-atomic="true">
      <div class="study-status-content">
        <span id="crosswake-study-status-icon" class="study-status-icon" aria-hidden="true">●</span>
        <div class="study-status-copy">
          <span id="crosswake-study-status-label">Saved answers paused</span>
          <p id="crosswake-study-status-message">Your saved answers remain on this iPhone.</p>
        </div>
        <span id="crosswake-study-status-indicator" hidden aria-label="Syncing saved answers"></span>
      </div>
      <div id="crosswake-study-status-action"></div>
    </div>

    <p id="card-position"></p>
    <div id="flashcard-container">
      Loading flashcards...
    </div>

    <div id="controls">
      <button id="btn-flip" class="btn-primary">Flip Card</button>
      <button id="btn-good" class="btn-primary" style="display: none;">Good</button>
      <button id="btn-hard" class="btn-secondary" style="display: none;">Hard</button>
    </div>

    <script type="module" src="/offline_study.js"></script>
  </body>
</html>
