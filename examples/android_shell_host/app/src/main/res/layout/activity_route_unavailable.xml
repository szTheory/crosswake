<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/route_unavailable_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Route unavailable"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/route_unavailable_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Crosswake blocked this activation before runtime mount."
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/route_unavailable_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Retry, update app, or open a safe fallback route."
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <TextView
            android:id="@+id/route_unavailable_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="pack_incompatible"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/route_unavailable_route_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:typeface="monospace" />

        <Button
            android:id="@+id/route_unavailable_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Retry" />

        <Button
            android:id="@+id/route_unavailable_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Update app" />

        <Button
            android:id="@+id/route_unavailable_safe_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Open safe fallback" />
    </LinearLayout>
</ScrollView>
