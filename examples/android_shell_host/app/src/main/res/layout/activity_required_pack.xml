<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/required_pack_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Required pack"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/required_pack_runtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1F0F766E"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="LiveView" />

        <TextView
            android:id="@+id/required_pack_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/required_pack_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pack name"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/required_pack_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Required version"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/required_pack_required_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Installed version"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/required_pack_installed_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/required_pack_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Latest verification"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/required_pack_verified_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/required_pack_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/required_pack_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Install Required Pack" />

        <Button
            android:id="@+id/required_pack_invalidate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Invalidate Pack" />

        <TextView
            android:id="@+id/required_pack_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
