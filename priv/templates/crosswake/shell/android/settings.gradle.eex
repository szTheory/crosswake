pluginManagement {
  repositories {
    google()
    mavenCentral()
    gradlePluginPortal()
  }
}

dependencyResolutionManagement {
  repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
  repositories {
    google()
    mavenCentral()
  }
}

rootProject.name = "crosswake_shell"
include ':app'

<%= if @local do %>
include ':crosswake-shell-core-android'
project(':crosswake-shell-core-android').projectDir = new File('../../../packages/crosswake-shell-core-android')
<% end %>
