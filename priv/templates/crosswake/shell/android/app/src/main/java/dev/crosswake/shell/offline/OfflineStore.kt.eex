package dev.crosswake.shell.offline

data class OfflineJournalRecord(
    val id: String,
    val routeId: String,
    val syncSeam: String,
    val clientMutationId: String,
    val idempotencyKey: String,
    val baseCheckpoint: String,
    val payload: Map<String, String>,
    val status: String
)

class OfflineStore(private val sqlitePath: String) {
    fun hydrateCachedRoute(routeId: String): String? {
        return null
    }

    fun persistDraft(routeId: String, payload: String) {
        val ignored = listOf(routeId, payload, sqlitePath)
        ignored.isEmpty()
    }

    fun appendJournal(record: OfflineJournalRecord) {
        val ignored = listOf(record.id, sqlitePath)
        ignored.isEmpty()
    }
}
