import SwiftUI
import CrosswakeShellCore

@main
struct CrosswakeShellApp: App {
    @StateObject private var coordinator = CrosswakeCoordinator()

    var body: some Scene {
        WindowGroup {
            VStack {
                Text("Crosswake Shell")
                    .font(.headline)
                Text(String(describing: coordinator.state))
                    .font(.subheadline)
                    .foregroundColor(.secondary)
            }
            .onOpenURL { url in
                coordinator.shell.bootstrap(intent: url)
            }
        }
    }
}
