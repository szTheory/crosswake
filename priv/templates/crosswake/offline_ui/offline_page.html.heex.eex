<%!-- Proto-copy: microcopy strings below match BRAND-SPEC.md §15 offline status vocabulary --%>
<div class="cw-offline-page">
  <div class="cw-offline-card">
    <h1 class="cw-offline-heading">Offline Workspace</h1>

    <div class="cw-offline-status" role="status">
      <h2 class="cw-offline-status-label">Status</h2>
      <p class="cw-offline-status-value">Available offline</p>
    </div>

    <ul class="cw-offline-session-list" role="list">
      <li class="cw-offline-session-item">
        <p class="cw-offline-session-title">Study Session A</p>
        <p class="cw-offline-session-subtitle">Pending server confirmation</p>
      </li>
      <li class="cw-offline-session-item">
        <p class="cw-offline-session-title">Study Session B</p>
        <p class="cw-offline-session-subtitle">Draft only</p>
      </li>
    </ul>
  </div>
</div>
