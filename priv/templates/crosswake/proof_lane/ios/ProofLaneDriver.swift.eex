// crosswake-proof-lane template_version=<%= @template_version %>
import Foundation

enum ProofLaneOutcome: String { case passed, blocked, unavailable }
enum ProofLanePrerequisite: String { case replayAuthorization, packAudio }

protocol ProofLaneDriver {
  func outcome(for prerequisite: ProofLanePrerequisite) -> ProofLaneOutcome
}

struct ProofLanePrerequisiteDriver: ProofLaneDriver {
  func outcome(for prerequisite: ProofLanePrerequisite) -> ProofLaneOutcome {
    switch prerequisite {
    case .replayAuthorization: return .blocked
    case .packAudio: return .unavailable
    }
  }
}
