import XCTest
@testable import CrosswakeProofLane

final class ProofLaneContractTests: XCTestCase {
  func testInstalledHostAdapterProducesPassedOutcome() throws {
    let adapter = try XCTUnwrap(ProofLaneHostAdapterFactory.make())
    let snapshot = adapter.observe()

    XCTAssertTrue(snapshot.shellBooted)
    XCTAssertEqual(snapshot.outcome, .passed)
  }
}
