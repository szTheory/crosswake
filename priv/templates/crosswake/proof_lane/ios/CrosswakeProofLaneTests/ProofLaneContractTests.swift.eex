import XCTest
@testable import CrosswakeProofLane

final class ProofLaneContractTests: XCTestCase {
  func testLaterPrerequisitesRemainExplicitlyNonPassing() {
    let driver = ProofLanePrerequisiteDriver()
    XCTAssertEqual(driver.outcome(for: .replayAuthorization), .blocked)
    XCTAssertEqual(driver.outcome(for: .packAudio), .unavailable)
    XCTAssertNotEqual(driver.outcome(for: .replayAuthorization), .passed)
    XCTAssertNotEqual(driver.outcome(for: .packAudio), .passed)
  }
}
