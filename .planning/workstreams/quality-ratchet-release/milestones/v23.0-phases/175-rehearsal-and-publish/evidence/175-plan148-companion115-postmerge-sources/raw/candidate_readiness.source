rosswake-ci.yml?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":".github/workflows/crosswake-ci.yml","patch":"@@ -410,6 +410,8 @@ jobs:\n       MIX_ENV: dev\n     steps:\n       - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7\n+        with:\n+          fetch-depth: 0\n       - uses: ./.github/actions/setup-elixir-cache\n         with:\n           mix-env: dev\n@@ -1103,6 +1105,8 @@ jobs:\n         run: ./gradlew publishToMavenLocal --no-daemon -PcrosswakeSkipSigning=true\n       - name: Run hermetic Android generated-shell verification\n         run: script/verify_generated_android_shell.sh\n+      - name: Check public Android propagation and build failure handling\n+        run: python3 script/verify_android_public_build_test.py\n       - name: Summarize generated Android proof\n         if: always()\n         run: |","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.github%2Fworkflows%2Fcrosswake-ci.yml","sha":"3e7ec4f5d50646f4d282907562737723f429413d","status":"modified"},{"additions":11,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.github%2Fworkflows%2Fexact-public-proof.yml","changes":12,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/.github%2Fworkflows%2Fexact-public-proof.yml?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":".github/workflows/exact-public-proof.yml","patch":"@@ -166,7 +166,10 @@ jobs:\n       - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0\n         if: ${{ steps.applicability.outputs.applicable == 'true' }}\n         with:\n-          ref: ${{ inputs.merge_oid }}\n+          # The guard proves this candidate is the actual merge's second parent\n+          # and has the identical tree. Fetch it independently of the manifest\n+          # so registry observations retain the approved candidate provenance.\n+          ref: ${{ inputs.approved_head }}\n           fetch-depth: 0\n           persist-credentials: false\n \n@@ -228,6 +231,13 @@ jobs:\n           version-file: .tool-versions\n           version-type: strict\n \n+      - name: Install exact-public proof dependencies\n+        if: ${{ steps.applicability.outputs.applicable == 'true' }}\n+        run: |\n+          mix local.hex --force\n+          mix local.rebar --force\n+          mix deps.get --check-locked\n+\n       - name: Download approved candidate payload manifest\n         if: ${{ steps.applicability.outputs.applicable == 'true' }}\n         env:","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.github%2Fworkflows%2Fexact-public-proof.yml","sha":"e72b41b383fb9e9b325d4719ebfc807e90eef4d1","status":"modified"},{"additions":69,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.github%2Fworkflows%2Fios-mirror-backfill.yml","changes":70,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/.github%2Fworkflows%2Fios-mirror-backfill.yml?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":".github/workflows/ios-mirror-backfill.yml","patch":"@@ -19,6 +19,19 @@ on:\n           - publish\n           - recovery\n           - tag-repair\n+      package:\n+        description: 'Core receipt or the planned Chimeway companion receipt.'\n+        required: false\n+        default: crosswake\n+        type: choice\n+        options:\n+          - crosswake\n+          - crosswake_chimeway\n+      candidate_pr:\n+        description: 'Exact open companion release PR number, for companion receipt attestation only.'\n+        required: false\n+        default: ''\n+        type: string\n       version:\n         description: 'Exact Crosswake lockstep version.'\n         required: true\n@@ -189,9 +202,57 @@ jobs:\n           if-no-files-found: error\n           retention-days: 14\n \n+  attest-companion-receipt:\n+    name: Attest planned companion receipt without publication credentials\n+    if: ${{ github.event.inputs.operation == 'candidate-receipt-attestation' && inputs.package == 'crosswake_chimeway' }}\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 20\n+    permissions:\n+      actions: read\n+      contents: read\n+    env:\n+      CANDIDATE_HEAD: \"${{ inputs.candidate_head }}\"\n+      CANDIDATE_TREE: \"${{ inputs.candidate_tree }}\"\n+      CANDIDATE_BASE: \"${{ inputs.candidate_base }}\"\n+      CANDIDATE_VERSION: \"${{ inputs.version }}\"\n+      CANDIDATE_PR: \"${{ inputs.candidate_pr }}\"\n+      CANDIDATE_CI_RUN_ID: \"${{ inputs.candidate_ci_run_id }}\"\n+      HEX_RUN_ID: \"${{ inputs.hex_run_id }}\"\n+      GH_TOKEN: ${{ github.token }}\n+    steps:\n+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0\n+        with:\n+          ref: ${{ inputs.candidate_head }}\n+          fetch-depth: 0\n+          persist-credentials: false\n+      - uses: ./.github/actions/setup-elixir-cache\n+        with:\n+          mix-env: test\n+      - name: Read exact candidate, successful CI, safe Hex artifact and absent target\n+        env:\n+          OUTPUT_DIR: ${{ runner.temp }}/companion-receipt-attestation\n+        run: |\n+          set -euo pipefail\n+          [ \"$(git rev-parse HEAD)\" = \"$CANDIDATE_HEAD\" ]\n+          [ \"$(git rev-parse 'HEAD^{tree}')\" = \"$CANDIDATE_TREE\" ]\n+          python3 script/release_candidate/companion_attestation.py\n+          mix crosswake.release.receipt --input \"$OUTPUT_DIR/input.json\" --output \"$OUTPUT_DIR/candidate-receipt.json\"\n+      - name: Upload source-bound companion receipt\n+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1\n+        with:\n+          name: phase168-candidate-receipt-${{ inputs.candidate_head }}\n+          path: |\n+            ${{ runner.temp }}/companion-receipt-attestation/candidate-receipt.json\n+            ${{ runner.temp }}/companion-receipt-attestation/candidate.json\n+            ${{ runner.temp }}/companion-receipt-attestation/ci.json\n+            ${{ runner.temp }}/companion-receipt-attestation/hex-rehearsal.json\n+            ${{ runner.temp }}/companion-receipt-attestation/package-row.json\n+          if-no-files-found: error\n+          retention-days: 7\n+\n   attest-candidate-receipt:\n     name: Attest canonical exact-head candidate receipt\n-    if: ${{ github.event.inputs.operation == 'candidate-receipt-attestation' }}\n+    if: ${{ github.event.inputs.operation == 'candidate-receipt-attestation' && inputs.package == 'crosswake' }}\n     runs-on: ubuntu-latest\n     timeout-minutes: 20\n     permissions:\n@@ -310,6 +371,13 @@ jobs:\n             '.candidate_version == $version and .requested_head == $head and .observed_head == $head and .observed_tree == $tree and .observed_base == $base and (.run_id | tostring) == $run and .run_conclusion == \"success\" and .state == \"VALIDATED\" and .deployment_result == \"DROP\" and .dropped == true and .external_state_changed == false' \\\n             \"$OUTPUT_DIR/maven/rehearsal.json\" >/dev/null\n \n+          # Independently resolve each package owner before accepting downloaded rows.\n+          for manifest in \"$OUTPUT_DIR/ci/artifacts/artifacts.json\" \"$OUTPUT_DIR/hex/packages/artifacts.json\"; do\n+            while IFS=$'\\t' read -r package version ref; do\n+              resolved=$(bash script/release_candidate/package_source_ref.sh \"$PWD\" \"$package\" \"$version\" \"$CANDIDATE_HEAD\")\n+              [ \"$ref\" = \"$resolved\" ]\n+            done < <(jq -r '.[] | [.package,.version,.candidate_ref] | @tsv' \"$manifest\")\n+          done\n           mix deps.get --check-locked\n           mix crosswake.release.candidate \\\n             --version \"$CANDIDATE_VERSION\" \\","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.github%2Fworkflows%2Fios-mirror-backfill.yml","sha":"a91d32b2ee7c3a8d6317eb1698563e27304a466b","status":"modified"},{"additions":30,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.github%2Fworkflows%2Frelease-please.yml","changes":73,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/.github%2Fworkflows%2Frelease-please.yml?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":43,"filename":".github/workflows/release-please.yml","patch":"@@ -298,8 +298,19 @@ jobs:\n               \"$receipt\" >/dev/null\n             cmp \"$receipt_dir/artifacts.json\" \"$ci_dir/artifacts/artifacts.json\"\n           else\n-            jq -e --arg digest \"$ci_receipt_sha\" \\\n-              'any(.receipt.proofs[]; .id == \"ci\" and .sha256 == $digest)' \"$receipt\" >/dev/null\n+            # CompanionReceipt binds the normalized same-head CI fact. Derive it\n+            # independently from the downloaded trusted CI receipt, preserving its\n+            # exact source digest rather than comparing two different JSON schemas.\n+            companion_ci_sha=$(python3 - \"$ci_receipt\" <<'PYCI'\n+          import hashlib,json,sys\n+          observed=json.load(open(sys.argv[1]))\n+          fact={\"run_id\":int(observed[\"run_id\"]),\"head_oid\":observed[\"head\"],\"conclusion\":\"success\"}\n+          print(hashlib.sha256(json.dumps(fact,sort_keys=True,separators=(\",\",\":\")).encode()).hexdigest())\n+          PYCI\n+            )\n+            jq -e --arg digest \"$companion_ci_sha\" --arg head \"$approved_head\" --argjson run \"$candidate_run_id\" \\\n+              '.receipt.ci == {\"run_id\":$run,\"head_oid\":$head,\"conclusion\":\"success\"} and\n+               any(.receipt.proofs[]; .id == \"ci\" and .sha256 == $digest)' \"$receipt\" >/dev/null\n           fi\n \n           # The exact pre-merge choice travels in the immutable merge message. A\n@@ -1135,24 +1146,18 @@ jobs:\n             --host-root \"$RUNNER_TEMP/clean-room-proof-ios-host\" \\\n             --target \"$RUNNER_TEMP/clean-room-proof-ios\"\n \n-      - name: swift build with mirror tag retry\n+      - name: Build generated iOS application against the public mirror\n         run: |\n           set -euo pipefail\n           PROJECT_ROOT=\"$RUNNER_TEMP/clean-room-proof-ios/native/ios/crosswake_shell\"\n-          cd \"$PROJECT_ROOT\"\n-\n-          for i in 1 2 3; do\n-            if swift build; then\n-              echo \"swift build succeeded on attempt $i\"\n-              exit 0\n-            fi\n-\n-            echo \"swift build attempt $i/3 failed; retrying in 30s for mirror tag availability...\"\n-            sleep 30\n-          done\n-\n-          echo \"swift build failed after 3 attempts.\"\n-          exit 1\n+          xcodebuild \\\n+            -project \"$PROJECT_ROOT/CrosswakeShell.xcodeproj\" \\\n+            -scheme CrosswakeShell \\\n+            -sdk iphonesimulator \\\n+            -destination 'generic/platform=iOS Simulator' \\\n+            -derivedDataPath \"$RUNNER_TEMP/clean-room-proof-ios-derived\" \\\n+            -clonedSourcePackagesDirPath \"$RUNNER_TEMP/clean-room-proof-ios-packages\" \\\n+            CODE_SIGNING_ALLOWED=NO ONLY_ACTIVE_ARCH=YES ARCHS=\"$(uname -m)\" build\n \n   clean-room-proof-android:\n     name: Clean-room proof — Android gradle build\n@@ -1180,40 +1185,22 @@ jobs:\n           mix local.hex --force\n           mix local.rebar --force\n \n-      - name: Install crosswake archive at just-cut version\n+      - name: Generate Android shell from an external consumer host\n         env:\n           VERSION: ${{ needs.release-please.outputs.version }}\n-        run: mix archive.install hex crosswake \"$VERSION\" --force\n-\n-      - name: Generate Android shell outside monorepo\n         run: |\n           set -euo pipefail\n-          TARGET=\"$RUNNER_TEMP/clean-room-proof-android\"\n-          rm -rf \"$TARGET\"\n-          mkdir -p \"$TARGET\"\n-          mix crosswake.gen.shell android --target \"$TARGET\"\n+          bash script/verify_android_release_host.sh \\\n+            --version \"$VERSION\" \\\n+            --host-root \"$RUNNER_TEMP/clean-room-proof-android-host\" \\\n+            --target \"$RUNNER_TEMP/clean-room-proof-android\"\n \n       - name: gradle build with Maven Central propagation polling\n+        env:\n+          VERSION: ${{ needs.release-please.outputs.version }}\n         run: |\n-          set -euo pipefail\n           PROJECT_ROOT=\"$RUNNER_TEMP/clean-room-proof-android/native/android/crosswake_shell\"\n-          cd \"$PROJECT_ROOT\"\n-          chmod +x gradlew\n-\n-          MAX_ATTEMPTS=40\n-          DELAY=45\n-          for i in $(seq 1 \"$MAX_ATTEMPTS\"); do\n-            if ./gradlew build --no-daemon; then\n-              echo \"gradle build succeeded on attempt $i\"\n-              exit 0\n-            fi\n-\n-            echo \"Attempt $i/$MAX_ATTEMPTS: gradle build failed; Maven Central may not have propagated. Retrying in ${DELAY}s...\"\n-            sleep \"$DELAY\"\n-          done\n-\n-          echo \"gradle build failed after $MAX_ATTEMPTS attempts (~30 min). Maven Central propagation timeout.\"\n-          exit 1\n+          bash script/verify_android_public_build.sh \"$PROJECT_ROOT\" \"$VERSION\"\n \n   exact-public-proof:\n     name: \"release: exact-public artifact proof\"","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.github%2Fworkflows%2Frelease-please.yml","sha":"16d4af6bac0bf67932e662fad3a808d2a99ca4db","status":"modified"},{"additions":3,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.release-please-manifest.json","changes":6,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/.release-please-manifest.json?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":3,"filename":".release-please-manifest.json","patch":"@@ -1,7 +1,7 @@\n {\n-  \".\": \"0.2.7\",\n-  \"packages/crosswake-shell-core-ios\": \"0.2.7\",\n-  \"packages/crosswake-shell-core-android\": \"0.2.7\",\n+  \".\": \"0.2.11\",\n+  \"packages/crosswake-shell-core-ios\": \"0.2.11\",\n+  \"packages/crosswake-shell-core-android\": \"0.2.11\",\n   \"packages/crosswake_rulestead\": \"0.1.1\",\n   \"packages/crosswake_rindle\": \"0.1.0\",\n   \"packages/crosswake_sigra\": \"0.1.3\",","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/.release-please-manifest.json","sha":"cf65a5829d4a6a24184b3dc1e8430e680a8c59e2","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/README.md","changes":2,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/README.md?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"README.md","patch":"@@ -229,7 +229,7 @@ container.\n - Elixir `~> 1.19`\n - Phoenix `~> 1.8`\n - Phoenix LiveView `~> 1.1`\n-- Crosswake version `0.2.7` <!-- x-release-please-version -->\n+- Crosswake version `0.2.11` <!-- x-release-please-version -->\n - Generated non-local native shell core coordinates resolve at the Crosswake package version.\n \n See [mix.exs](mix.exs) and [guides/support_matrix.md](guides/support_matrix.md) for","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/README.md","sha":"89ea66ad17b29c5340af92609dded69e744aa057","status":"modified"},{"additions":2,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/examples%2Fandroid_shell_host%2Fapp%2Fbuild.gradle","changes":4,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/examples%2Fandroid_shell_host%2Fapp%2Fbuild.gradle?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":2,"filename":"examples/android_shell_host/app/build.gradle","patch":"@@ -12,7 +12,7 @@ android {\n     minSdk 30\n     targetSdk 35\n     versionCode 1\n-    versionName \"0.2.7\" // x-release-please-version\n+    versionName \"0.2.11\" // x-release-please-version\n     testInstrumentationRunner \"androidx.test.runner.AndroidJUnitRunner\"\n   }\n \n@@ -73,7 +73,7 @@ android {\n }\n \n dependencies {\n-  implementation 'io.github.sztheory:crosswake-shell-core-android:0.2.7' // x-release-please-version\n+  implementation 'io.github.sztheory:crosswake-shell-core-android:0.2.11' // x-release-please-version\n   implementation 'androidx.core:core-ktx:1.13.1'\n   implementation 'androidx.appcompat:appcompat:1.7.0'\n   implementation 'androidx.activity:activity-compose:1.9.0'","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/examples%2Fandroid_shell_host%2Fapp%2Fbuild.gradle","sha":"da36a0201a8e0d12926e22bb00709d4f834aade6","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/examples%2Fandroid_shell_host%2Fapp%2Fsrc%2Fmain%2Fassets%2Fcrosswake_manifest.json","changes":2,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/examples%2Fandroid_shell_host%2Fapp%2Fsrc%2Fmain%2Fassets%2Fcrosswake_manifest.json?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"examples/android_shell_host/app/src/main/assets/crosswake_manifest.json","patch":"@@ -353,7 +353,7 @@\n       \"remote\"\n     ]\n   },\n-  \"crosswake_version\": \"0.2.7\",\n+  \"crosswake_version\": \"0.2.11\",\n   \"generated_at\": \"2026-06-02T01:19:43Z\",\n   \"host\": {\n     \"live_view_version\": \"~> 1.1\",","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/examples%2Fandroid_shell_host%2Fapp%2Fsrc%2Fmain%2Fassets%2Fcrosswake_manifest.json","sha":"e247099f901bd14acf452e29fe4cecefd3a8d097","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/examples%2Fios_shell_host%2FFixtures%2Fcrosswake_manifest.json","c