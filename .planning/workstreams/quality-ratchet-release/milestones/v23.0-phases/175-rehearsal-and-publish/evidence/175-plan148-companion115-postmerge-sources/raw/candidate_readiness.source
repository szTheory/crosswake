ides/android_uat.md","patch":"@@ -1,6 +1,6 @@\n # Android Device-UAT Checklist\n \n-**Last verified against:** Crosswake v0.2.7 on Android 15 (API 35) <!-- x-release-please-version -->\n+**Last verified against:** Crosswake v0.2.11 on Android 15 (API 35) <!-- x-release-please-version -->\n \n ## What This Proves\n ","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/guides%2Fandroid_uat.md","sha":"52c658740e3dfd907b038930fd1f4e4603f70938","status":"modified"},{"additions":3,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/lib%2Fcrosswake%2Frelease_candidate%2Fevidence_input.ex","changes":4,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/lib%2Fcrosswake%2Frelease_candidate%2Fevidence_input.ex?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"lib/crosswake/release_candidate/evidence_input.ex","patch":"@@ -286,7 +286,9 @@ defmodule Crosswake.ReleaseCandidate.EvidenceInput do\n \n       unless row[\"package\"] == expected_package and is_binary(row[\"version\"]) and\n                Regex.match?(~r/\\A\\d+\\.\\d+\\.\\d+\\z/, row[\"version\"]) and\n-               row[\"candidate_ref\"] == ref and row[\"source\"] == \"built_tarball\" and\n+               sha?(row[\"candidate_ref\"]) and\n+               (expected_package != \"crosswake\" or row[\"candidate_ref\"] == ref) and\n+               row[\"source\"] == \"built_tarball\" and\n                is_list(row[\"files\"]) and row[\"files\"] != [] and is_list(row[\"requirements\"]) and\n                digest?(row[\"outer_checksum\"]) and digest?(row[\"payload_digest\"]) and\n                digest?(row[\"metadata_digest\"]),","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/lib%2Fcrosswake%2Frelease_candidate%2Fevidence_input.ex","sha":"693eac2593f29d68aa16683bc8c1a148f9385f37","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/lib%2Fcrosswake%2Frelease_candidate%2Fworkflow.ex","changes":2,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/lib%2Fcrosswake%2Frelease_candidate%2Fworkflow.ex?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"lib/crosswake/release_candidate/workflow.ex","patch":"@@ -141,7 +141,7 @@ defmodule Crosswake.ReleaseCandidate.Workflow do\n     %{\n       hex: \"hex:crosswake@#{version}\",\n       ios_mirror: \"swift:crosswake-shell-core-ios@#{version}\",\n-      android: \"maven:io.crosswake:crosswake-shell-core@#{version}\"\n+      android: \"maven:io.github.sztheory:crosswake-shell-core-android@#{version}\"\n     }\n   end\n ","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/lib%2Fcrosswake%2Frelease_candidate%2Fworkflow.ex","sha":"1fceaa63c904f934edd7e562c4e88c5a8a656f88","status":"modified"},{"additions":16,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/lib%2Fmix%2Ftasks%2Fcrosswake.gen.shell.ex","changes":22,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/lib%2Fmix%2Ftasks%2Fcrosswake.gen.shell.ex?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":6,"filename":"lib/mix/tasks/crosswake.gen.shell.ex","patch":"@@ -18,7 +18,7 @@ defmodule Mix.Tasks.Crosswake.Gen.Shell do\n   @diff_excluded_templates [\"CrosswakeShell.xcodeproj/project.pbxproj\"]\n   @platforms ~w(ios android)\n \n-  @template_version 2\n+  @template_version 3\n \n   @doc \"\"\"\n   Returns the current integer template epoch.\n@@ -44,7 +44,8 @@ defmodule Mix.Tasks.Crosswake.Gen.Shell do\n      \"android/app/src/main/java/dev/crosswake/shell/MainActivity.kt.eex\"},\n     {\"app/src/main/java/dev/crosswake/shell/CrosswakeViewModel.kt\",\n      \"android/app/src/main/java/dev/crosswake/shell/CrosswakeViewModel.kt.eex\"},\n-    {\"app/src/main/res/values/themes.xml\", \"android/app/src/main/res/values/themes.xml.eex\"}\n+    {\"app/src/main/res/values/themes.xml\", \"android/app/src/main/res/values/themes.xml.eex\"},\n+    {\"app/src/main/res/values-v28/themes.xml\", \"android/app/src/main/res/values/themes.xml.eex\"}\n   ]\n   @ios_templates [\n     {\"CrosswakeShell/CrosswakeShellApp.swift\", \"ios/CrosswakeShellApp.swift.eex\"},\n@@ -193,7 +194,15 @@ defmodule Mix.Tasks.Crosswake.Gen.Shell do\n             {ota, rebuild, unch, miss}\n           else\n             on_disk_path = Path.join(root, relative_path)\n-            re_rendered = render_template(template_path, capabilities, effective_local, assigns)\n+\n+            re_rendered =\n+              render_template(\n+                template_path,\n+                capabilities,\n+                effective_local,\n+                assigns,\n+                relative_path\n+              )\n \n             case File.read(on_disk_path) do\n               {:error, :enoent} ->\n@@ -410,7 +419,7 @@ defmodule Mix.Tasks.Crosswake.Gen.Shell do\n     Enum.each(@android_templates, fn {relative_path, template_path} ->\n       ensure_file(\n         Path.join(root, relative_path),\n-        render_template(template_path, capabilities, local, assigns)\n+        render_template(template_path, capabilities, local, assigns, relative_path)\n       )\n     end)\n   end\n@@ -426,7 +435,7 @@ defmodule Mix.Tasks.Crosswake.Gen.Shell do\n     end)\n   end\n \n-  defp render_template(template_path, capabilities, local, assigns) do\n+  defp render_template(template_path, capabilities, local, assigns, relative_path \\\\ \"\") do\n     template =\n       Application.app_dir(:crosswake, Path.join(\"priv/templates/crosswake/shell\", template_path))\n \n@@ -439,7 +448,8 @@ defmodule Mix.Tasks.Crosswake.Gen.Shell do\n           capabilities: capabilities,\n           local: local,\n           version: version,\n-          template_version: @template_version\n+          template_version: @template_version,\n+          cutout_mode: String.contains?(relative_path, \"/values-v28/\")\n         ] ++ assigns\n     )\n   end","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/lib%2Fmix%2Ftasks%2Fcrosswake.gen.shell.ex","sha":"6885473bbc11640c78b50e5e977c8622662736dc","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/mix.exs","changes":2,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/mix.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"mix.exs","patch":"@@ -2,7 +2,7 @@ defmodule Crosswake.MixProject do\n   use Mix.Project\n \n   # x-release-please-version\n-  @version \"0.2.7\"\n+  @version \"0.2.11\"\n   @source_url \"https://github.com/szTheory/crosswake\"\n \n   def project do","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/mix.exs","sha":"a8b9d96b908b82521e8d968e58f2dbd60fb7f145","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/packages%2Fcrosswake-shell-core-android%2Fbuild.gradle.kts","changes":2,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/packages%2Fcrosswake-shell-core-android%2Fbuild.gradle.kts?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"packages/crosswake-shell-core-android/build.gradle.kts","patch":"@@ -7,7 +7,7 @@ plugins {\n     id(\"com.vanniktech.maven.publish\") version \"0.31.0\"\n }\n \n-version = \"0.2.7\" // x-release-please-version\n+version = \"0.2.11\" // x-release-please-version\n \n // A fire-drill may exercise the signed Portal upload with an invocation-owned coordinate.\n // Release Please still owns the literal above; the override never changes the checked-in version.","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/packages%2Fcrosswake-shell-core-android%2Fbuild.gradle.kts","sha":"376c079e55a8f0f1e99944d4f0a9110540fc2f66","status":"modified"},{"additions":4,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/packages%2Fcrosswake-shell-core-android%2Fsrc%2Fmain%2Fjava%2Fdev%2Fcrosswake%2Fshell%2Fcore%2FDiagnosticExportManager.kt","changes":4,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/packages%2Fcrosswake-shell-core-android%2Fsrc%2Fmain%2Fjava%2Fdev%2Fcrosswake%2Fshell%2Fcore%2FDiagnosticExportManager.kt?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"packages/crosswake-shell-core-android/src/main/java/dev/crosswake/shell/core/DiagnosticExportManager.kt","patch":"@@ -43,6 +43,10 @@ object DiagnosticExportManager {\n     }\n \n     private fun exportExitInfo(info: ApplicationExitInfo, endpointUrl: String, runtimeVersion: String) {\n+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {\n+            return\n+        }\n+\n         val (kind, exitReason) = mapExitReason(info.reason)\n         \n         val nativeDiagnostic = JSONObject().apply {","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/packages%2Fcrosswake-shell-core-android%2Fsrc%2Fmain%2Fjava%2Fdev%2Fcrosswake%2Fshell%2Fcore%2FDiagnosticExportManager.kt","sha":"92adc0acb1f6da225cb1263f3ca4ecdefe24f4df","status":"modified"},{"additions":2,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/priv%2Ftemplates%2Fcrosswake%2Fshell%2Fandroid%2Fapp%2Fsrc%2Fmain%2Fres%2Fvalues%2Fthemes.xml.eex","changes":3,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/priv%2Ftemplates%2Fcrosswake%2Fshell%2Fandroid%2Fapp%2Fsrc%2Fmain%2Fres%2Fvalues%2Fthemes.xml.eex?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"priv/templates/crosswake/shell/android/app/src/main/res/values/themes.xml.eex","patch":"@@ -5,6 +5,7 @@\n     <style name=\"Theme.CrosswakeShell\" parent=\"Theme.AppCompat.DayNight.NoActionBar\">\n         <item name=\"android:statusBarColor\">@android:color/transparent</item>\n         <item name=\"android:navigationBarColor\">@android:color/transparent</item>\n-        <item name=\"android:windowLayoutInDisplayCutoutMode\">shortEdges</item>\n+<%= if @cutout_mode do %>        <item name=\"android:windowLayoutInDisplayCutoutMode\">shortEdges</item>\n+<% end %>\n     </style>\n </resources>","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/priv%2Ftemplates%2Fcrosswake%2Fshell%2Fandroid%2Fapp%2Fsrc%2Fmain%2Fres%2Fvalues%2Fthemes.xml.eex","sha":"9e467f09d44473dcf138b38d1a38a9612f654105","status":"modified"},{"additions":106,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Frelease_candidate%2Fcompanion_attestation.py","changes":106,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Frelease_candidate%2Fcompanion_attestation.py?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"script/release_candidate/companion_attestation.py","patch":"@@ -0,0 +1,106 @@\n+#!/usr/bin/env python3\n+\"\"\"Read-only preparation for the planned companion receipt; no release authority.\"\"\"\n+import hashlib\n+import json\n+import os\n+import pathlib\n+import re\n+import subprocess\n+import urllib.error\n+import urllib.request\n+\n+REPOSITORY = \"szTheory/crosswake\"\n+\n+\n+def gh(path):\n+    return json.loads(subprocess.check_output([\"gh\", \"api\", f\"repos/{REPOSITORY}/{path}\"], timeout=30))\n+\n+\n+def canonical(value):\n+    return json.dumps(value, sort_keys=True, separators=(\",\", \":\"))\n+\n+\n+def validate(candidate, ci, hex_run, ci_receipt, rehearsal, rows, selectors):\n+    head, tree, base, pr, ci_id, hex_id, version = selectors\n+    assert candidate == {\"pr\": pr, \"base_oid\": base, \"head_oid\": head, \"tree_oid\": tree, \"ci_run_id\": ci_id}\n+    for run, number, name in [(ci, ci_id, \"Crosswake CI\"), (hex_run, hex_id, \"Hex candidate rehearsal and recovery\")]:\n+        assert run[\"id\"] == number and run[\"head_sha\"] == head\n+        assert run[\"status\"] == \"completed\" and run[\"conclusion\"] == \"success\" and run[\"name\"] == name\n+    assert hex_run[\"event\"] == \"workflow_dispatch\"\n+    assert ci_receipt[\"state\"] == \"PASS\" and ci_receipt[\"head\"] == head and ci_receipt[\"tree\"] == tree\n+    assert ci_receipt[\"base\"] == base and int(ci_receipt[\"run_id\"]) == ci_id\n+    assert ci_receipt[\"external_state_changed\"] is False\n+    assert rehearsal[\"requested_head\"] == head and rehearsal[\"observed_head\"] == head\n+    assert rehearsal[\"observed_tree\"] == tree and rehearsal[\"observed_base\"] == base\n+    assert int(rehearsal[\"run_id\"]) == hex_id and rehearsal[\"run_head\"] == head\n+    assert rehearsal[\"run_conclusion\"] == \"success\" and rehearsal[\"external_state_changed\"] is False\n+    assert rehearsal[\"package_count\"] == 6\n+    assert [row[\"package\"] for row in rows] == [\"crosswake\", \"crosswake_rulestead\", \"crosswake_rindle\", \"crosswake_sigra\", \"crosswake_chimeway\", \"crosswake_threadline\"]\n+    selected = [row for row in rows if row[\"package\"] == \"crosswake_chimeway\"]\n+    assert len(selected) == 1\n+    row = selected[0]\n+    assert row[\"version\"] == version and row[\"candidate_ref\"] == head\n+    for key in [\"outer_checksum\", \"metadata_digest\", \"payload_digest\"]:\n+        assert re.fullmatch(r\"[0-9a-f]{64}\", row[key])\n+    return {key: row[key] for key in [\"package\", \"version\", \"candidate_ref\", \"outer_checksum\", \"metadata_digest\", \"payload_digest\"]} | {\"run_id\": hex_id}\n+\n+\n+def main():\n+    head, tree, base = [os.environ[key] for key in [\"CANDIDATE_HEAD\", \"CANDIDATE_TREE\", \"CANDIDATE_BASE\"]]\n+    for value in [head, tree, base]:\n+        assert re.fullmatch(r\"[0-9a-f]{40}\", value)\n+    version = os.environ[\"CANDIDATE_VERSION\"]\n+    assert re.fullmatch(r\"[0-9]+\\.[0-9]+\\.[0-9]+\", version)\n+    pr, ci_id, hex_id = [int(os.environ[key]) for key in [\"CANDIDATE_PR\", \"CANDIDATE_CI_RUN_ID\", \"HEX_RUN_ID\"]]\n+    assert pr > 0 and ci_id > 0 and hex_id > 0\n+    root = pathlib.Path(os.environ[\"OUTPUT_DIR\"])\n+    assert not root.exists()\n+    root.mkdir(mode=0o700)\n+    info = gh(f\"pulls/{pr}\")\n+    assert info[\"state\"] == \"open\" and info[\"draft\"] is False\n+    assert info[\"head\"][\"sha\"] == head and info[\"base\"][\"sha\"] == base and info[\"base\"][\"ref\"] == \"main\"\n+    assert gh(f\"git/commits/{head}\")[\"tree\"][\"sha\"] == tree\n+    assert gh(\"git/ref/heads/main\")[\"object\"][\"sha\"] == base\n+    candidate = {\"pr\": pr, \"base_oid\": base, \"head_oid\": head, \"tree_oid\": tree, \"ci_run_id\": ci_id}\n+    ci, hex_run = gh(f\"actions/runs/{ci_id}\"), gh(f\"actions/runs/{hex_id}\")\n+    for run, number, name in [(ci, ci_id, \"Crosswake CI\"), (hex_run, hex_id, \"Hex candidate rehearsal and recovery\")]:\n+        assert run[\"id\"] == number and run[\"head_sha\"] == head and run[\"conclusion\"] == \"success\" and run[\"status\"] == \"completed\" and run[\"name\"] == name\n+    for number, name, directory in [(ci_id, f\"phase168-candidate-ci-{head}\", \"ci\"), (hex_id, \"candidate-rehearsal-hex\", \"hex\")]:\n+        subprocess.run([\"gh\", \"run\", \"download\", str(number), \"--repo\", REPOSITORY, \"--name\", name, \"--dir\", str(root / directory)], check=True, timeout=120)\n+    ci_receipt = json.loads((root / \"ci/release-candidate-ci-receipt.json\").read_bytes())\n+    rehearsal = json.loads((root / \"hex/rehearsal.json\").read_bytes())\n+    manifest_bytes = (root / \"hex/packages/artifacts.json\").read_bytes()\n+    assert hashlib.sha256(manifest_bytes).hexdigest() == rehearsal[\"package_artifacts_sha256\"]\n+    assert hashlib.sha256(pathlib.Path(\".github/workflows/hex-publish.yml\").read_bytes()).hexdigest() == rehearsal[\"workflow_sha256\"]\n+    row = validate(candidate, ci, hex_run, ci_receipt, rehearsal, json.loads(manifest_bytes), (head, tree, base, pr, ci_id, hex_id, version))\n+    declared = pathlib.Path(\"packages/crosswake_chimeway/mix.exs\").read_text()\n+    assert re.search(r'@version\\s+\"([^\"]+)\"', declared).group(1) == version\n+    try:\n+        response = urllib.request.urlopen(f\"https://hex.pm/api/packages/crosswake_chimeway/releases/{version}\", timeout=30)\n+    except urllib.error.HTTPError as error:\n+        assert error.code == 404\n+    else:\n+        response.close()\n+        raise AssertionError(\"companion target is already public\")\n+    projected_ci = {\"run_id\": ci_id, \"head_oid\": head, \"conclusion\": \"success\"}\n+    projected_hex = {\"run_id\": hex_id, \"head_oid\": head, \"package\": \"crosswake_chimeway\", \"version\": version, \"external_state_changed\": False, \"target_absent\": True}\n+    facts = {\"candidate\": candidate, \"ci\": projected_ci, \"hex_rehearsal\": projected_hex, \"package_row\": row}\n+    sources = {}\n+    for key, value in facts.items():\n+        name = key.replace(\"_\", \"-\") + \".json\"\n+        data = canonical(value)\n+        (root / name).write_text(data)\n+        sources[key] = {\"path\": name, \"bytes\": data}\n+    payload = {\"package\": \"crosswake_chimeway\", \"version\": version, **facts, \"sources\": sources}\n+    (root / \"input.json\").write_text(canonical(payload))\n+    # Re-read mutable candidate pointers after acquisition; never preserve account fields.\n+    latest = gh(f\"pulls/{pr}\")\n+    assert latest[\"state\"] == \"open\" and latest[\"head\"][\"sha\"] == head and latest[\"base\"][\"sha\"] == base\n+    assert gh(\"git/ref/heads/main\")[\"object\"][\"sha\"] == base\n+\n+\n+if __name__ == \"__main__\":\n+    try:\n+        main()\n+    except Exception:\n+        raise SystemExit(\"Companion receipt blocked: source, run, artifact, or target validation failed.\")","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Frelease_candidate%2Fcompanion_attestation.py","sha":"ff8feb196b6cc003939aabe162f7adf80a94c48d","status":"added"},{"additions":12,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Frelease_candidate%2Fhex_artifacts.sh","changes":15,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Frelease_candidate%2Fhex_artifacts.sh?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":3,"filename":"script/release_candidate/hex_artifacts.sh","patch":"@@ -97,14 +97,15 @@ CORE_UNPACKED_ROOT=\"\"\n \n prepare_companion_source() {\n   local package=\"$1\"\n+  local package_ref=\"$2\"\n   local source_root=\"$OUTPUT_DIR/.scratch/sources/$package\"\n   local package_dir=\"$source_root/packages/$package\"\n   local dependency_source\n \n   mkdir -p \"$source_root\"\n   # Preserve exact-candidate path dependencies between companions (for example,\n   # Chimeway's test-only Sigra dependency) inside the isolated source tree.\n-  git archive \"$CANDIDATE_REF\" packages | tar -x -C \"$source_root\"\n+  git -c tar.umask=0022 archive \"$package_ref\" packages | tar -xp -C \"$source_root\"\n   mkdir -p \"$package_dir/deps\"\n \n   for dependency_source in \"$REPO_ROOT/packages/$package/deps/\"*; do\n@@ -178,11 +179,18 @@ prepare_companion_source() {\n }\n \n for PACKAGE in \"${PACKAGES[@]}\"; do\n+  if [ \"$PACKAGE\" = \"crosswake\" ]; then\n+    DECLARED_DIR=\"$REPO_ROOT\"\n+  else\n+    DECLARED_DIR=\"$REPO_ROOT/packages/$PACKAGE\"\n+  fi\n+  DECLARED_VERSION=$(sed -n 's/^[[:space:]]*@version \"\\([^\"]*\\)\".*/\\1/p' \"$DECLARED_DIR/mix.exs\")\n+  PACKAGE_REF=$(bash \"$SCRIPT_DIR/package_source_ref.sh\" \"$REPO_ROOT\" \"$PACKAGE\" \"$DECLARED_VERSION\" \"$CANDIDATE_REF\") || fail\n   if [ \"$PACKAGE\" = \"crosswake\" ]; then\n     PACKAGE_DIR=\"$REPO_ROOT\"\n   else\n     [ -n \"$CORE_TARBALL\" ] && [ -n \"$CORE_UNPACKED_ROOT\" ] || fail\n-    PACKAGE_DIR=$(prepare_companion_source \"$PACKAGE\") || fail\n+    PACKAGE_DIR=$(prepare_companion_source \"$PACKAGE\" \"$PACKAGE_REF\") || fail\n   fi\n \n   VERSION=$(cd \"$PACKAGE_DIR\" && env \\\n@@ -232,7 +240,8 @@ for PACKAGE in \"${PACKAGES[@]}\"; do\n   fi\n \n   OUTER_CHECKSUM=$(shasum -a 256 \"$TARBALL\" | awk '{print $1}')\n-  ARTIFACT_ARGS+=(\"$PACKAGE\" \"$VERSION\" \"$CANDIDATE_REF\" \"$TARBALL\" \"$UNPACKED_ROOT\" \"$OUTER_CHECKSUM\" \"built_tarball\")\n+  [ \"$VERSION\" = \"$DECLARED_VERSION\" ] || fail\n+  ARTIFACT_ARGS+=(\"$PACKAGE\" \"$VERSION\" \"$PACKAGE_REF\" \"$TARBALL\" \"$UNPACKED_ROOT\" \"$OUTER_CHECKSUM\" \"built_tarball\")\n \n   if [ \"$PACKAGE\" = \"crosswake\" ]; then\n     CORE_TARBALL=\"$TARBALL\"","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Frelease_candidate%2Fhex_artifacts.sh","sha":"4835814c8dda8deafd8ebe06e6c89941b99d397f","status":"modified"},{"additions":26,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Frelease_candidate%2Fpackage_source_ref.sh","changes":26,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Frelease_candidate%2Fpackage_source_ref.sh?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"script/release_candidate/package_source_ref.sh","patch":"@@ -0,0 +1,26 @@\n+#!/usr/bin/env bash\n+# Resolve package ownership independently of artifact manifests.\n+set -euo pipefail\n+[ \"$#\" -eq 4 ] || [ \"$#\" -eq 5 ] || exit 2\n+repo=$1 package=$2 version=$3 candidate=$4 mode=${5:-candidate}\n+case \"$mode\" in candidate|public) ;; *) exit 2 ;; esac\n+printf '%s' \"$version\" | grep -Eq '^[0-9]+\\.[0-9]+\\.[0-9]+$'\n+printf '%s' \"$candidate\" | grep -Eq '^[0-9a-f]{40}$'\n+case \"$package\" in\n+  crosswake) git -C \"$repo\" cat-file -e \"$candidate^{commit}\"; printf '%s\\n' \"$candidate\"; exit 0 ;;\n+  crosswake_rulestead|crosswake_rindle|crosswake_sigra|crosswake_chimeway|crosswake_threadline) ;;\n+  *) exit 2 ;;\n+esac\n+tag=\"refs/tags/$package-v$version\"\n+# A failed provider read is fatal; only a successful empty read denotes an unpublished version.\n+refs=$(git -C \"$repo\" ls-remote --tags https://github.com/szTheory/crosswake.git \"$tag\" \"$tag^{}\")\n+if [ -z \"$refs\" ]; then\n+  [ \"$mode\" = candidate ] || exit 1\n+  git -C \"$repo\" cat-file -e \"$candidate^{commit}\"\n+  printf '%s\\n' \"$candidate\"\n+else\n+  object=$(printf '%s\\n' \"$refs\" | awk -v tag=\"$tag\" '$2 == tag { print $1 }')\n+  printf '%s' \"$object\" | grep -Eq '^[0-9a-f]{40}$'\n+  # Checkout fetch-depth:0 supplies the object. Missing objects fail closed.\n+  git -C \"$repo\" rev-parse --verify \"$object^{commit}\"\n+fi","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Frelease_candidate%2Fpackage_source_ref.sh","sha":"584bfca24dc47da647581ebb3424b52c762fd0c2","status":"added"},{"additions":34,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_android_public_build.sh","changes":34,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Fverify_android_public_build.sh?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"script/verify_android_public_build.sh","patch":"@@ -0,0 +1,34 @@\n+#!/usr/bin/env bash\n+set -euo pipefail\n+project_root=\"${1:?generated Android project required}\"\n+version=\"${2:?exact published version required}\"\n+[[ \"$version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+$ ]] || { echo 'Invalid exact Maven version' >&2; exit 1; }\n+[[ -f \"$project_root/gradlew\" ]] || { echo 'Generated Gradle wrapper missing' >&2; exit 1; }\n+coordinate=\"https://repo.maven.apache.org/maven2/io/github/sztheory/crosswake-shell-core-android/$version/crosswake-shell-core-android-$version\"\n+max_attempts=\"${CROSSWAKE_MAVEN_POLL_ATTEMPTS:-40}\"\n+delay=\"${CROSSWAKE_MAVEN_POLL_DELAY:-45}\"\n+[[ \"$max_attempts\" =~ ^[1-9][0-9]*$ && \"$max_attempts\" -le 40 ]] || exit 1\n+[[ \"$delay\" =~ ^[0-9]+$ && \"$delay\" -le 45 ]] || exit 1\n+available=false\n+for ((attempt = 1; attempt <= max_attempts; attempt++)); do\n+  available=true\n+  for extension in pom aar; do\n+    if ! status=$(curl --silent --show-error --location --max-time 30 --output /dev/null --write-out '%{http_code}' \"$coordinate.$extension\"); then\n+      available=false\n+      break\n+    fi\n+    case \"$status\" in\n+      200) ;;\n+      404|429|5??) available=false ;;\n+      *) echo \"Maven $extension returned unexpected HTTP $status; refusing build\" >&2; exit 1 ;;\n+    esac\n+  done\n+  if [[ \"$available\" == true ]]; then break; fi\n+  echo \"Maven coordinate not available yet ($attempt/$max_attempts)\"\n+  if ((attempt < max_attempts)); then sleep \"$delay\"; fi\n+ done\n+[[ \"$available\" == true ]] || { echo 'Exact Maven coordinate propagation timed out' >&2; exit 1; }\n+cd \"$project_root\"\n+chmod +x gradlew\n+echo 'Exact Maven POM and AAR available; running full Gradle build once'\n+./gradlew build --no-daemon --refresh-dependencies","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_android_public_build.sh","sha":"a5f89b1f91882ca531d51641c393e81b3fa5cfdf","status":"added"},{"additions":80,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_android_public_build_test.py","changes":80,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Fverify_android_public_build_test.py?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"script/verify_android_public_build_test.py","patch":"@@ -0,0 +1,80 @@\n+#!/usr/bin/env python3\n+\"\"\"Exercise existing release consumer propagation/build boundary without a network.\"\"\"\n+import os\n+from pathlib import Path\n+import subprocess\n+import tempfile\n+import unittest\n+\n+SCRIPT = Path(__file__).with_name('verify_android_public_build.sh')\n+\n+\n+class PublicBuildTest(unittest.TestCase):\n+    def exercise(self, statuses, gradle_exit=0, version='0.2.10'):\n+        with tempfile.TemporaryDirectory() as folder:\n+            root = Path(folder)\n+            tools = root / 'bin'\n+            tools.mkdir()\n+            project = root / 'generated'\n+            project.mkdir()\n+            (root / 'statuses').write_text('\\n'.join(statuses) + '\\n')\n+            (tools / 'curl').write_text('''#!/usr/bin/env python3\n+import os\n+from pathlib import Path\n+p=Path(os.environ['FIXTURE_ROOT'])/'statuses'\n+a=p.read_text().splitlines()\n+p.write_text('\\\\n'.join(a[1:])+'\\\\n')\n+print(a[0], end='')\n+''')\n+            (project / 'gradlew').write_text('''#!/usr/bin/env bash\n+printf '%s\\\\n' \"$*\" >> \"$FIXTURE_ROOT/builds\"\n+exit \"$FIXTURE_GRADLE_EXIT\"\n+''')\n+            (tools / 'curl').chmod(0o755)\n+            env = dict(os.environ, PATH=str(tools) + ':' + os.environ['PATH'],\n+                       FIXTURE_ROOT=str(root), FIXTURE_GRADLE_EXIT=str(gradle_exit),\n+                       CROSSWAKE_MAVEN_POLL_ATTEMPTS='3', CROSSWAKE_MAVEN_POLL_DELAY='0')\n+            result = subprocess.run(['bash', str(SCRIPT), str(project), version],\n+                                    env=env, capture_output=True, text=True)\n+            builds = (root / 'builds').read_text().splitlines() if (root / 'builds').exists() else []\n+            return result, builds\n+\n+    def test_public_coordinate_then_one_full_build(self):\n+        result, builds = self.exercise(['200', '200'])\n+        self.assertEqual(result.returncode, 0, result.stderr)\n+        self.assertEqual(builds, ['build --no-daemon --refresh-dependencies'])\n+\n+    def test_missing_coordinate_polls_without_building(self):\n+        result, builds = self.exercise(['404', '404', '200', '200'])\n+        self.assertEqual(result.returncode, 0, result.stderr)\n+        self.assertEqual(len(builds), 1)\n+\n+    def test_build_failure_is_not_retried_or_called_propagation(self):\n+        result, builds = self.exercise(['200', '200'], 7)\n+        self.assertEqual(result.returncode, 7)\n+        self.assertEqual(len(builds), 1)\n+        self.assertNotIn('timed out', result.stderr)\n+\n+    def test_timeout_never_builds(self):\n+        result, builds = self.exercise(['404', '404'] * 3)\n+        self.assertNotEqual(result.returncode, 0)\n+        self.assertEqual(builds, [])\n+\n+    def test_authorization_error_is_fatal(self):\n+        result, builds = self.exercise(['403'])\n+        self.assertNotEqual(result.returncode, 0)\n+        self.assertEqual(builds, [])\n+\n+    def test_missing_aar_never_builds(self):\n+        result, builds = self.exercise(['200', '404'] * 3)\n+        self.assertNotEqual(result.returncode, 0)\n+        self.assertEqual(builds, [])\n+\n+    def test_invalid_version_never_builds(self):\n+        result, builds = self.exercise([], version='../other')\n+        self.assertNotEqual(result.returncode, 0)\n+        self.assertEqual(builds, [])\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_android_public_build_test.py","sha":"feb0ec0c91b7b3ff8559bab881647d443e1eecd2","status":"added"},{"additions":64,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_android_release_host.sh","changes":64,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Fverify_android_release_host.sh?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"script/verify_android_release_host.sh","patch":"@@ -0,0 +1,64 @@\n+#!/usr/bin/env bash\n+set -euo pipefail\n+\n+usage() {\n+  echo \"usage: verify_android_release_host.sh --version VERSION --host-root DIR --target DIR\" >&2\n+  exit 2\n+}\n+\n+version=\"\"\n+host_root=\"\"\n+target=\"\"\n+while [ \"$#\" -gt 0 ]; do\n+  case \"$1\" in\n+    --version) [ \"$#\" -ge 2 ] || usage; version=\"$2\"; shift 2 ;;\n+    --host-root) [ \"$#\" -ge 2 ] || usage; host_root=\"$2\"; shift 2 ;;\n+    --target) [ \"$#\" -ge 2 ] || usage; target=\"$2\"; shift 2 ;;\n+    *) usage ;;\n+  esac\n+done\n+\n+[[ \"$version\" =~ ^[0-9]+\\.[0-9]+\\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || usage\n+[ -n \"$host_root\" ] && [ -n \"$target\" ] || usage\n+[ ! -e \"$host_root\" ] && [ ! -e \"$target\" ] || {\n+  echo \"consumer host and target paths must not already exist\" >&2\n+  exit 1\n+}\n+\n+repo_root=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n+mkdir -p \"$(dirname \"$host_root\")\" \"$(dirname \"$target\")\"\n+mix new \"$host_root\" --app crosswake_release_proof >/dev/null\n+cp \"$repo_root/.tool-versions\" \"$host_root/.tool-versions\"\n+mkdir -p \"$target\"\n+\n+cat > \"$host_root/mix.exs\" <<'ELIXIR'\n+defmodule CrosswakeReleaseProof.MixProject do\n+  use Mix.Project\n+\n+  def project do\n+    [app: :crosswake_release_proof, version: \"0.1.0\", elixir: \"~> 1.19\", deps: deps()]\n+  end\n+\n+  def application, do: [extra_applications: [:logger]]\n+\n+  defp deps do\n+    version = System.fetch_env!(\"CROSSWAKE_VERSION\")\n+    [{:crosswake, \"== #{version}\"}]\n+  end\n+end\n+ELIXIR\n+\n+(\n+  cd \"$host_root\"\n+  export CROSSWAKE_VERSION=\"$version\"\n+  mix deps.get\n+  deps_report=\"$(mix deps)\"\n+  printf '%s\\n' \"$deps_report\"\n+  printf '%s\\n' \"$deps_report\" | grep -F \"* crosswake (Hex package)\" >/dev/null\n+  printf '%s\\n' \"$deps_report\" | grep -F \"  locked at $version (crosswake)\" >/dev/null\n+  mix crosswake.gen.shell android --target \"$target\"\n+)\n+\n+manifest=\"$target/native/android/crosswake_shell/app/src/main/assets/crosswake_manifest.json\"\n+jq -e '.crosswake_version | type == \"string\" and length > 0' \"$manifest\" >/dev/null\n+echo \"external Hex consumer generated Android shell for Crosswake $version\"","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_android_release_host.sh","sha":"d14a688314cfa6aa9ea7fb289029b6291c12e9e6","status":"added"},{"additions":5,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_companion_cleanroom.sh","changes":9,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Fverify_companion_cleanroom.sh?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":4,"filename":"script/verify_companion_cleanroom.sh","patch":"@@ -208,20 +208,21 @@ PYEOF\n     # The observed ref is resolved independently from the checked-out repository head, never\n     # from the approved manifest it is later compared against (D-172-B, T-172-01) — deriving it\n     # from that manifest would make the 172-02 provenance comparison true by construction.\n-    MATRIX_PUBLIC_REF=$(git -C \"$MATRIX_REPO_ROOT\" rev-parse HEAD) || matrix_fail\n-    printf '%s' \"$MATRIX_PUBLIC_REF\" | grep -Eq '^[0-9a-f]{40}$' || matrix_fail\n+    MATRIX_CORE_REF=$(git -C \"$MATRIX_REPO_ROOT\" rev-parse HEAD) || matrix_fail\n+    printf '%s' \"$MATRIX_CORE_REF\" | grep -Eq '^[0-9a-f]{40}$' || matrix_fail\n \n     for package in crosswake crosswake_rulestead crosswake_rindle crosswake_sigra crosswake_chimeway crosswake_threadline; do\n       version=$(jq -er --arg package \"$package\" '.[] | select(.package == $package) | .version' \"$MATRIX_APPROVED_MANIFEST\") || matrix_fail\n       approved_ref=$(jq -er --arg package \"$package\" '.[] | select(.package == $package) | .candidate_ref' \"$MATRIX_APPROVED_MANIFEST\") || matrix_fail\n+      MATRIX_PUBLIC_REF=$(bash \"$MATRIX_REPO_ROOT/script/release_candidate/package_source_ref.sh\" \"$MATRIX_REPO_ROOT\" \"$package\" \"$version\" \"$MATRIX_CORE_REF\" public) || matrix_fail\n       tarball=\"$public_root/tarballs/$package-$version.tar\"\n       unpacked_root=\"$public_root/unpacked/$package\"\n \n       echo \"[crosswake] source_mode=exact-public package=$package version=$version candidate_ref=$approved_ref step=fetch\"\n       if ! env MIX_HOME=\"$MATRIX_GENERATOR_MIX_HOME\" HEX_HOME=\"$MATRIX_GENERATOR_HEX_HOME\" \\\n         ASDF_ERLANG_VERSION=\"$MATRIX_ASDF_ERLANG_VERSION\" \\\n         ASDF_ELIXIR_VERSION=\"$MATRIX_ASDF_ELIXIR_VERSION\" \\\n-        \"${RUNTIME[@]}\" mix hex.package fetch \"$package\" \"$version\" --output \"$tarball\" \\\n+        \"${RUNTIME[@]}\" mix hex.package fetch \"$package\" \"$version\" --output \"$public_root/tarballs\" \\\n           >\"$MATRIX_INVOCATION_ROOT/fetch-$package.log\" 2>&1; then\n         failed+=(\"$package\")\n         continue\n@@ -251,7 +252,7 @@ PYEOF\n     done\n \n     if [ \"${#failed[@]}\" -gt 0 ]; then\n-      SUCCEEDED_PACKAGES=$(IFS=,; echo \"${succeeded[*]}\")\n+      SUCCEEDED_PACKAGES=$(IFS=,; echo \"${succeeded[*]:-}\")\n       FAILED_PACKAGES=$(IFS=,; echo \"${failed[*]}\")\n       SUCCEEDED_PACKAGES=\"$SUCCEEDED_PACKAGES\" FAILED_PACKAGES=\"$FAILED_PACKAGES\" python3 - <<'PYEOF'\n import json","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_companion_cleanroom.sh","sha":"c97f6334f20bb3fe48b9648abcc251ca8c4534b9","status":"modified"},{"additions":3,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_generated_android_shell.sh","changes":4,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/script%2Fverify_generated_android_shell.sh?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"script/verify_generated_android_shell.sh","patch":"@@ -257,17 +257,19 @@ prepare_generated_shell() {\n   # keying off the env var alone selects a non-existent prod task and the build fails.\n   if grep -q \"productFlavors\" app/build.gradle 2>/dev/null; then\n     UNIT_TEST_TASK=\"testProdDebugUnitTest\"\n+    LINT_TASK=\"lintProdDebug\"\n     CONNECTED_TEST_TASK=\"connectedProdDebugAndroidTest\"\n   else\n     UNIT_TEST_TASK=\"testDebugUnitTest\"\n+    LINT_TASK=\"lintDebug\"\n     CONNECTED_TEST_TASK=\"connectedDebugAndroidTest\"\n   fi\n \n }\n \n run_generated_shell_jvm_proof() {\n   prepare_generated_shell\n-  ./gradlew --no-daemon --stacktrace \"${UNIT_TEST_TASK}\"\n+  ./gradlew --no-daemon --stacktrace \"${UNIT_TEST_TASK}\" \"${LINT_TASK}\"\n }\n \n run_connected_shell_proof() {","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/script%2Fverify_generated_android_shell.sh","sha":"25ba6b0c3f8c3b2377658d0e11e1c730c8c16f30","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Fproof%2Fphase134_template_version_drift_test.exs","changes":2,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Fproof%2Fphase134_template_version_drift_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"test/crosswake/proof/phase134_template_version_drift_test.exs","patch":"@@ -23,7 +23,7 @@ defmodule Crosswake.Proof.Phase134TemplateVersionDriftTest do\n \n   @template_dir Path.join([File.cwd!(), \"priv\", \"templates\", \"crosswake\", \"shell\"])\n \n-  @checked_in_hash \"54ca60edcbe7f16826b782514492c48c4d8d67d8d1b81ad0fb1e40b5b97b0454\"\n+  @checked_in_hash \"f198560f1925e2da47f6db18b3a74680b22788aeb110bb8363f65eed68c6d035\"\n \n   # ---------------------------------------------------------------------------\n   # SC#1 — drift guard: live template hash must match the checked-in hash.","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Fproof%2Fphase134_template_version_drift_test.exs","sha":"dab5c310525b41ca2bbdd90b869a2809d43fa912","status":"modified"},{"additions":4,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Fproof%2Fphase172_per_package_ref_test.exs","changes":8,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Fproof%2Fphase172_per_package_ref_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":4,"filename":"test/crosswake/proof/phase172_per_package_ref_test.exs","patch":"@@ -51,7 +51,7 @@ defmodule Crosswake.Proof.Phase172PerPackageRefTest do\n              \"a per-package candidate_ref lookup, keyed on $package, must be present in its place\"\n     end\n \n-    test \"the observed ref is assigned exactly once, from a repository head resolution, never from the approved manifest\" do\n+    test \"the observed ref is assigned per package from independently resolved source ownership\" do\n       source = non_comment_source!(@script)\n \n       assignments = Regex.scan(~r/^\\s*MATRIX_PUBLIC_REF=.*$/m, source) |> List.flatten()\n@@ -61,8 +61,8 @@ defmodule Crosswake.Proof.Phase172PerPackageRefTest do\n \n       [assignment] = assignments\n \n-      assert assignment =~ ~r/git -C \"\\$MATRIX_REPO_ROOT\" rev-parse HEAD/,\n-             \"the single MATRIX_PUBLIC_REF assignment must resolve independently from git rev-parse HEAD\"\n+      assert assignment =~ \"package_source_ref.sh\",\n+             \"the per-package observed ref must resolve independently from GitHub release tags or the checked-out core head\"\n \n       refute assignment =~ \"MATRIX_APPROVED_MANIFEST\",\n              \"MATRIX_PUBLIC_REF must never be resolved from the approved manifest it is later compared against (T-172-01)\"\n@@ -108,7 +108,7 @@ defmodule Crosswake.Proof.Phase172PerPackageRefTest do\n              \"ARTIFACT_ARGS must append exactly #{@artifact_field_count} positional fields per \" <>\n                \"package; found #{quoted_token_count(line)} in: #{line}\"\n \n-      assert line =~ \"\\\"$CANDIDATE_REF\\\"\",\n+      assert line =~ \"\\\"$PACKAGE_REF\\\"\",\n              \"the candidate ref must still be one of the appended fields\"\n     end\n   end","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Fproof%2Fphase172_per_package_ref_test.exs","sha":"acfb0a7da4dfda915a7a74394186e89f1f767c01","status":"modified"},{"additions":1,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fcleanroom_test.exs","changes":2,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Frelease_candidate%2Fcleanroom_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"test/crosswake/release_candidate/cleanroom_test.exs","patch":"@@ -629,7 +629,7 @@ defmodule Crosswake.ReleaseCandidate.CleanroomTest do\n              ~S{select(.package == $package) | .candidate_ref}\n \n     assert script =~\n-             ~S{MATRIX_PUBLIC_REF=$(git -C \"$MATRIX_REPO_ROOT\" rev-parse HEAD)}\n+             ~S{MATRIX_CORE_REF=$(git -C \"$MATRIX_REPO_ROOT\" rev-parse HEAD)}\n \n     refute script =~ \"unique\"\n     refute candidate_task =~ \"verify_companion_cleanroom\"","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fcleanroom_test.exs","sha":"01897949bba45a0d04717282f952a2e30ac670be","status":"modified"},{"additions":40,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fcompanion_attestation_test.exs","changes":40,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Frelease_candidate%2Fcompanion_attestation_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"test/crosswake/release_candidate/companion_attestation_test.exs","patch":"@@ -0,0 +1,40 @@\n+defmodule Crosswake.ReleaseCandidate.CompanionAttestationTest do\n+  use ExUnit.Case, async: true\n+\n+  test \"hosted companion adapter rejects stale and mismatched source facts\" do\n+    {output, status} =\n+      System.cmd(\"python3\", [\"test/support/companion_attestation_check.py\"],\n+        stderr_to_stdout: true\n+      )\n+\n+    assert status == 0, output\n+  end\n+\n+  test \"hosted companion receipt has no publication credentials or core attestation requirements\" do\n+    source = File.read!(\".github/workflows/ios-mirror-backfill.yml\")\n+    [_, rest] = String.split(source, \"  attest-companion-receipt:\", parts: 2)\n+    [job | _] = String.split(rest, \"  attest-candidate-receipt:\", parts: 2)\n+    assert job =~ \"inputs.package == 'crosswake_chimeway'\"\n+    assert job =~ \"actions: read\"\n+    assert job =~ \"contents: read\"\n+    [settings, steps] = String.split(job, \"    steps:\", parts: 2)\n+    refute settings =~ \"runner.temp\"\n+\n+    assert steps =~\n+             \"        env:\\n          OUTPUT_DIR: ${{ runner.temp }}/companion-receipt-attestation\"\n+\n+    assert job =~ \"mix crosswake.release.receipt\"\n+    assert job =~ \"phase168-candidate-receipt-${{ inputs.candidate_head }}\"\n+\n+    for forbidden <- [\n+          \"secrets.\",\n+          \"MIRROR_DEPLOY_KEY\",\n+          \"hex.publish\",\n+          \"gh pr merge\",\n+          \"ios_run_id\",\n+          \"maven_run_id\"\n+        ] do\n+      refute job =~ forbidden\n+    end\n+  end\n+end","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fcompanion_attestation_test.exs","sha":"eb4e37ece806f7767f1b2751e184c26f6db384d0","status":"added"},{"additions":20,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fevidence_gate_test.exs","changes":30,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Frelease_candidate%2Fevidence_gate_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":10,"filename":"test/crosswake/release_candidate/evidence_gate_test.exs","patch":"@@ -67,16 +67,17 @@ defmodule Crosswake.ReleaseCandidate.EvidenceGateTest do\n \n     {output, status} =\n       System.cmd(\"bash\", [\"script/release_candidate/require_release_evidence.sh\"],\n-        env: [\n-          {\"MIX_ENV\", \"test\"},\n-          {\"REL17_OPERATION\", \"linked_release\"},\n-          {\"REL17_PACKAGE\", \"crosswake\"},\n-          {\"REL17_RECEIPT_DIGEST\", @receipt_digest},\n-          {\"REL17_LEG_RUN_ID\", Integer.to_string(@leg_run_id)},\n-          {\"REL17_MERGE_OID\", @merge},\n-          {\"REL17_ENVELOPE_FILE\", envelope_file},\n-          {\"REL17_SOURCE_DIR\", source_dir}\n-        ],\n+        env:\n+          isolated_release_env([\n+            {\"MIX_ENV\", \"test\"},\n+            {\"REL17_OPERATION\", \"linked_release\"},\n+            {\"REL17_PACKAGE\", \"crosswake\"},\n+            {\"REL17_RECEIPT_DIGEST\", @receipt_digest},\n+            {\"REL17_LEG_RUN_ID\", Integer.to_string(@leg_run_id)},\n+            {\"REL17_MERGE_OID\", @merge},\n+            {\"REL17_ENVELOPE_FILE\", envelope_file},\n+            {\"REL17_SOURCE_DIR\", source_dir}\n+          ]),\n         stderr_to_stdout: true\n       )\n \n@@ -429,4 +430,13 @@ defmodule Crosswake.ReleaseCandidate.EvidenceGateTest do\n   end\n \n   defp digest(bytes), do: :crypto.hash(:sha256, bytes) |> Base.encode16(case: :lower)\n+  # Fixture subprocesses must not inherit a live publisher's authorization.\n+  # Keep the real release context intact in the parent workflow process.\n+  defp isolated_release_env(overrides) do\n+    System.get_env()\n+    |> Enum.filter(fn {key, _value} -> String.starts_with?(key, \"REL17_\") end)\n+    |> Map.new(fn {key, _value} -> {key, nil} end)\n+    |> Map.merge(Map.new(overrides))\n+    |> Enum.to_list()\n+  end\n end","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fevidence_gate_test.exs","sha":"c465c8639439188b542465900ba0ef566e375cc8","status":"modified"},{"additions":18,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fmirror_test.exs","changes":25,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Frelease_candidate%2Fmirror_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":7,"filename":"test/crosswake/release_candidate/mirror_test.exs","patch":"@@ -260,13 +260,14 @@ defmodule Crosswake.ReleaseCandidate.MirrorTest do\n   test \"local bare mirror publication blocks without REL-17 authority and preserves refs\" do\n     fixture = git_fixture()\n \n-    env = [\n-      {\"CROSSWAKE_IOS_MIRROR_RELEASE_REPO\", fixture.release_repo},\n-      {\"CROSSWAKE_IOS_MIRROR_PUBLIC_REMOTE\", fixture.mirror_repo},\n-      {\"CROSSWAKE_IOS_MIRROR_WRITE_REMOTE\", fixture.mirror_repo},\n-      {\"CROSSWAKE_IOS_MIRROR_AUTHORIZATION_CHECKED\", \"true\"},\n-      {\"CROSSWAKE_IOS_MIRROR_EXECUTE\", \"true\"}\n-    ]\n+    env =\n+      isolated_release_env([\n+        {\"CROSSWAKE_IOS_MIRROR_RELEASE_REPO\", fixture.release_repo},\n+        {\"CROSSWAKE_IOS_MIRROR_PUBLIC_REMOTE\", fixture.mirror_repo},\n+        {\"CROSSWAKE_IOS_MIRROR_WRITE_REMOTE\", fixture.mirror_repo},\n+        {\"CROSSWAKE_IOS_MIRROR_AUTHORIZATION_CHECKED\", \"true\"},\n+        {\"CROSSWAKE_IOS_MIRROR_EXECUTE\", \"true\"}\n+      ])\n \n     {output, status} =\n       System.cmd(\n@@ -455,4 +456,14 @@ defmodule Crosswake.ReleaseCandidate.MirrorTest do\n     |> List.last()\n     |> hd()\n   end\n+\n+  # Fixture subprocesses must not inherit a live publisher's authorization.\n+  # Keep the real release context intact in the parent workflow process.\n+  defp isolated_release_env(overrides) do\n+    System.get_env()\n+    |> Enum.filter(fn {key, _value} -> String.starts_with?(key, \"REL17_\") end)\n+    |> Map.new(fn {key, _value} -> {key, nil} end)\n+    |> Map.merge(Map.new(overrides))\n+    |> Enum.to_list()\n+  end\n end","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fmirror_test.exs","sha":"07cbce3bdce9d7d213dfab77fd8f7717faef4892","status":"modified"},{"additions":96,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fpackage_source_ref_test.exs","changes":96,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Frelease_candidate%2Fpackage_source_ref_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"test/crosswake/release_candidate/package_source_ref_test.exs","patch":"@@ -0,0 +1,96 @@\n+defmodule Crosswake.ReleaseCandidate.PackageSourceRefTest do\n+  use ExUnit.Case, async: true\n+\n+  @head String.duplicate(\"a\", 40)\n+  @tag_sha String.duplicate(\"b\", 40)\n+  @script Path.expand(\"../../../script/release_candidate/package_source_ref.sh\", __DIR__)\n+\n+  @tag :tmp_dir\n+  test \"published companions resolve their release tag independently of candidate head\", ctx do\n+    {output, status} = run(ctx.tmp_dir, \"published\", \"crosswake_sigra\", \"public\")\n+    assert status == 0\n+    assert String.trim(output) == @tag_sha\n+  end\n+\n+  @tag :tmp_dir\n+  test \"only unpublished candidate packages may fall back to candidate source\", ctx do\n+    assert {String.trim(@head) <> \"\\n\", 0} ==\n+             run(ctx.tmp_dir, \"absent\", \"crosswake_sigra\", \"candidate\")\n+\n+    assert {\"\", 1} == run(ctx.tmp_dir, \"absent\", \"crosswake_sigra\", \"public\")\n+  end\n+\n+  @tag :tmp_dir\n+  test \"provider failure and missing tagged objects fail closed\", ctx do\n+    for scenario <- [\"provider_failed\", \"missing_object\"] do\n+      {_output, status} = run(ctx.tmp_dir, scenario, \"crosswake_sigra\", \"candidate\")\n+      assert status != 0\n+    end\n+  end\n+\n+  @tag :tmp_dir\n+  test \"core remains bound to independently checked candidate commit\", ctx do\n+    assert {@head <> \"\\n\", 0} == run(ctx.tmp_dir, \"provider_failed\", \"crosswake\", \"public\")\n+  end\n+\n+  @tag :tmp_dir\n+  test \"archive permissions are canonical across Git defaults and private scratch umask\", ctx do\n+    producer = File.read!(\"script/release_candidate/hex_artifacts.sh\")\n+    assert producer =~ ~S{git -c tar.umask=0022 archive \"$package_ref\" packages | tar -xp}\n+\n+    shell = \"\"\"\n+    set -euo pipefail\n+    umask 077\n+    git init --bare \"$1/repo\" >/dev/null 2>&1\n+    blob=$(printf 'public package fixture' | git --git-dir=\"$1/repo\" hash-object -w --stdin)\n+    tree=$(printf '100644 blob %s\\\\tfixture.txt\\\\n' \"$blob\" | git --git-dir=\"$1/repo\" mktree)\n+    mkdir \"$1/runner-default\" \"$1/canonical\"\n+    git -c tar.umask=0002 --git-dir=\"$1/repo\" archive \"$tree\" | tar -xp -C \"$1/runner-default\"\n+    git -c tar.umask=0002 -c tar.umask=0022 --git-dir=\"$1/repo\" archive \"$tree\" | tar -xp -C \"$1/canonical\"\n+    \"\"\"\n+\n+    {output, status} =\n+      System.cmd(\"bash\", [\"-c\", shell, \"archive-permissions\", ctx.tmp_dir],\n+        stderr_to_stdout: true\n+      )\n+\n+    assert status == 0, output\n+\n+    assert Bitwise.band(\n+             File.stat!(Path.join(ctx.tmp_dir, \"runner-default/fixture.txt\")).mode,\n+             0o777\n+           ) == 0o664\n+\n+    assert Bitwise.band(File.stat!(Path.join(ctx.tmp_dir, \"canonical/fixture.txt\")).mode, 0o777) ==\n+             0o644\n+  end\n+\n+  defp run(tmp, scenario, package, mode) do\n+    shim = Path.join(tmp, \"git\")\n+\n+    File.write!(shim, \"\"\"\n+    #!/bin/bash\n+    shift 2\n+    case \"$1\" in\n+      ls-remote)\n+        case \"$SOURCE_TEST_SCENARIO\" in\n+          provider_failed) exit 7 ;;\n+          absent) exit 0 ;;\n+          *) printf '%s\\\\t%s\\\\n' '#{@tag_sha}' 'refs/tags/crosswake_sigra-v0.1.3' ;;\n+        esac ;;\n+      cat-file) exit 0 ;;\n+      rev-parse)\n+        [ \"$SOURCE_TEST_SCENARIO\" != missing_object ] || exit 9\n+        printf '%s\\\\n' '#{@tag_sha}' ;;\n+      *) exit 10 ;;\n+    esac\n+    \"\"\")\n+\n+    File.chmod!(shim, 0o755)\n+\n+    System.cmd(\"bash\", [@script, tmp, package, \"0.1.3\", @head, mode],\n+      env: [{\"PATH\", tmp <> \":\" <> System.get_env(\"PATH\")}, {\"SOURCE_TEST_SCENARIO\", scenario}],\n+      stderr_to_stdout: true\n+    )\n+  end\n+end","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fpackage_source_ref_test.exs","sha":"ebd48437dcdba821ad6c4519c7f4c562e6068fd3","status":"added"},{"additions":27,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fworkflow_test.exs","changes":29,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fcrosswake%2Frelease_candidate%2Fworkflow_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":2,"filename":"test/crosswake/release_candidate/workflow_test.exs","patch":"@@ -524,6 +524,31 @@ defmodule Crosswake.ReleaseCandidate.WorkflowTest do\n     end\n   end\n \n+  test \"linked rollup rejects the obsolete Maven coordinate\" do\n+    children =\n+      Map.new(\n+        ~w(hex ios_mirror android ios_public_proof android_public_proof exact_public)a,\n+        &{&1, \"success\"}\n+      )\n+\n+    valid = Workflow.rollup!(rollup_input(children, \"0.2.10\"))\n+\n+    assert \"maven:io.github.sztheory:crosswake-shell-core-android@0.2.10\" in valid.successful_coordinates\n+\n+    obsolete =\n+      Enum.map(valid.successful_coordinates, fn coordinate ->\n+        String.replace(\n+          coordinate,\n+          \"io.github.sztheory:crosswake-shell-core-android\",\n+          \"io.crosswake:crosswake-shell-core\"\n+        )\n+      end)\n+\n+    assert_raise ArgumentError, \"release workflow observation is invalid\", fn ->\n+      Workflow.validate!(%{valid | successful_coordinates: obsolete})\n+    end\n+  end\n+\n   test \"coordinate derivation is a function of the input version, not a frozen literal\" do\n     children = %{\n       hex: \"success\",\n@@ -544,7 +569,7 @@ defmodule Crosswake.ReleaseCandidate.WorkflowTest do\n              Enum.sort([\n                \"hex:crosswake@0.2.2\",\n                \"swift:crosswake-shell-core-ios@0.2.2\",\n-               \"maven:io.crosswake:crosswake-shell-core@0.2.2\"\n+               \"maven:io.github.sztheory:crosswake-shell-core-android@0.2.2\"\n              ])\n \n     for {a, b} <- Enum.zip(result_a.successful_coordinates, result_b.successful_coordinates) do\n@@ -883,5 +908,5 @@ defmodule Crosswake.ReleaseCandidate.WorkflowTest do\n \n   defp coordinate(:hex), do: \"hex:crosswake@0.2.1\"\n   defp coordinate(:ios_mirror), do: \"swift:crosswake-shell-core-ios@0.2.1\"\n-  defp coordinate(:android), do: \"maven:io.crosswake:crosswake-shell-core@0.2.1\"\n+  defp coordinate(:android), do: \"maven:io.github.sztheory:crosswake-shell-core-android@0.2.1\"\n end","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fcrosswake%2Frelease_candidate%2Fworkflow_test.exs","sha":"6044c257565f7c8263d862c6e5065c8a6aca0f1e","status":"modified"},{"additions":23,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fmix%2Ftasks%2Fcrosswake_gen_shell_stamp_test.exs","changes":24,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fmix%2Ftasks%2Fcrosswake_gen_shell_stamp_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":1,"filename":"test/mix/tasks/crosswake_gen_shell_stamp_test.exs","patch":"@@ -38,7 +38,8 @@ defmodule Mix.Tasks.Crosswake.Gen.ShellStampTest do\n     \"app/src/main/AndroidManifest.xml\",\n     \"app/src/main/java/dev/crosswake/shell/MainActivity.kt\",\n     \"app/src/main/java/dev/crosswake/shell/CrosswakeViewModel.kt\",\n-    \"app/src/main/res/values/themes.xml\"\n+    \"app/src/main/res/values/themes.xml\",\n+    \"app/src/main/res/values-v28/themes.xml\"\n   ]\n \n   # D-02 stamp exclusions: these MUST NOT carry a stamp.\n@@ -91,6 +92,27 @@ defmodule Mix.Tasks.Crosswake.Gen.ShellStampTest do\n     end\n   end\n \n+  test \"Android cutout mode is confined to API 28 resources\" do\n+    target = tmp_dir!(\"cutout-api\")\n+\n+    capture_io(fn ->\n+      Mix.Task.reenable(@task)\n+      Mix.Task.run(@task, [\"android\", \"--target\", target])\n+    end)\n+\n+    root = Path.join(target, \"native/android/crosswake_shell/app/src/main/res\")\n+    base = File.read!(Path.join(root, \"values/themes.xml\"))\n+    qualified = File.read!(Path.join(root, \"values-v28/themes.xml\"))\n+    refute base =~ \"windowLayoutInDisplayCutoutMode\"\n+    assert qualified =~ \"windowLayoutInDisplayCutoutMode\"\n+    assert qualified =~ \"Theme.AppCompat.DayNight.NoActionBar\"\n+\n+    for item <- [\"android:statusBarColor\", \"android:navigationBarColor\"] do\n+      assert base =~ item\n+      assert qualified =~ item\n+    end\n+  end\n+\n   test \"gradle.properties is stamped (regression guard for review finding 4a)\" do\n     target = tmp_dir!(\"stamp-gradle-props\")\n ","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fmix%2Ftasks%2Fcrosswake_gen_shell_stamp_test.exs","sha":"2c3457b781ce2d2c45301a72ea163a043a087070","status":"modified"},{"additions":56,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fmix%2Ftasks%2Fcrosswake_release_candidate_test.exs","changes":56,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fmix%2Ftasks%2Fcrosswake_release_candidate_test.exs?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"test/mix/tasks/crosswake_release_candidate_test.exs","patch":"@@ -223,6 +223,62 @@ defmodule Mix.Tasks.Crosswake.Release.CandidateTest do\n     assert File.read!(Path.join(second_output_dir, \"candidate-receipt.json\")) == receipt_bytes\n   end\n \n+  @tag :tmp_dir\n+  test \"companion refs remain per package while core and independent builders stay bound\", %{\n+    tmp_dir: tmp_dir\n+  } do\n+    for {scenario, ref} <- [\n+          {\"matching\", @sha_b},\n+          {\"mismatch\", @sha_c},\n+          {\"malformed\", \"not-a-ref\"}\n+        ] do\n+      fixture = Crosswake.ReleaseCandidateReceiptFixtures.build!(Path.join(tmp_dir, scenario))\n+\n+      for {kind, source_ref} <- [{:ci_packages, @sha_b}, {:hex_packages, ref}] do\n+        Crosswake.ReleaseCandidateReceiptFixtures.mutate_json!(fixture, kind, fn rows ->\n+          Enum.map(rows, fn row ->\n+            if row[\"package\"] == \"crosswake_sigra\",\n+              do: Map.put(row, \"candidate_ref\", source_ref),\n+              else: row\n+          end)\n+        end)\n+      end\n+\n+      digest = fn key ->\n+        fixture.root\n+        |> Path.join(fixture.files[key])\n+        |> File.read!()\n+        |> then(&:crypto.hash(:sha256, &1))\n+        |> Base.encode16(case: :lower)\n+      end\n+\n+      Crosswake.ReleaseCandidateReceiptFixtures.mutate_json!(\n+        fixture,\n+        :ci,\n+        &Map.put(&1, \"artifact_manifest_sha256\", digest.(:ci_packages))\n+      )\n+\n+      Crosswake.ReleaseCandidateReceiptFixtures.mutate_json!(\n+        fixture,\n+        :hex,\n+        &Map.put(&1, \"package_artifacts_sha256\", digest.(:hex_packages))\n+      )\n+\n+      output = Path.join(tmp_dir, scenario <> \"-receipt\")\n+\n+      if scenario == \"matching\" do\n+        assert capture_io(fn -> Candidate.run(evidence_args(fixture, output)) end) =~\n+                 \"READY FOR APPROVAL\"\n+      else\n+        assert_raise ArgumentError, \"candidate evidence is invalid\", fn ->\n+          capture_io(fn -> Candidate.run(evidence_args(fixture, output)) end)\n+        end\n+\n+        refute File.exists?(output)\n+      end\n+    end\n+  end\n+\n   @tag :tmp_dir\n   test \"missing, stale identity/run bindings and unexpected sensitive fields fail closed\", %{\n     tmp_dir: tmp_dir","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fmix%2Ftasks%2Fcrosswake_release_candidate_test.exs","sha":"30e4e3d8b607f65c82149436bdaf605773649277","status":"modified"},{"additions":52,"blob_url":"https://github.com/szTheory/crosswake/blob/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fsupport%2Fcompanion_attestation_check.py","changes":52,"contents_url":"https://api.github.com/repos/szTheory/crosswake/contents/test%2Fsupport%2Fcompanion_attestation_check.py?ref=0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","deletions":0,"filename":"test/support/companion_attestation_check.py","patch":"@@ -0,0 +1,52 @@\n+import copy\n+import importlib.util\n+import pathlib\n+import unittest\n+\n+ROOT = pathlib.Path(__file__).resolve().parents[2]\n+spec = importlib.util.spec_from_file_location(\"attestation\", ROOT / \"script/release_candidate/companion_attestation.py\")\n+a = importlib.util.module_from_spec(spec)\n+spec.loader.exec_module(a)\n+\n+\n+class AttestationTest(unittest.TestCase):\n+    def fixture(self):\n+        head, tree, base = \"a\" * 40, \"b\" * 40, \"c\" * 40\n+        candidate = dict(pr=115, base_oid=base, head_oid=head, tree_oid=tree, ci_run_id=100)\n+        ci = dict(id=100, head_sha=head, status=\"completed\", conclusion=\"success\", name=\"Crosswake CI\")\n+        hex_run = dict(ci, id=200, name=\"Hex candidate rehearsal and recovery\", event=\"workflow_dispatch\")\n+        receipt = dict(state=\"PASS\", head=head, tree=tree, base=base, run_id=\"100\", external_state_changed=False)\n+        rehearsal = dict(requested_head=head, observed_head=head, observed_tree=tree, observed_base=base,\n+                         run_id=\"200\", run_head=head, run_conclusion=\"success\", external_state_changed=False, package_count=6)\n+        rows = [dict(package=name, version=\"0.1.1\", candidate_ref=head, outer_checksum=\"d\"*64,\n+                     metadata_digest=\"e\"*64, payload_digest=\"f\"*64) for name in\n+                [\"crosswake\", \"crosswake_rulestead\", \"crosswake_rindle\", \"crosswake_sigra\", \"crosswake_chimeway\", \"crosswake_threadline\"]]\n+        return [candidate, ci, hex_run, receipt, rehearsal, rows, (head, tree, base, 115, 100, 200, \"0.1.1\")]\n+\n+    def test_exact_sources_pass(self):\n+        row = a.validate(*self.fixture())\n+        self.assertEqual(row[\"package\"], \"crosswake_chimeway\")\n+        self.assertEqual(row[\"run_id\"], 200)\n+\n+    def test_mutated_sources_fail(self):\n+        for index, key, value in [(0,\"head_oid\",\"9\"*40),(1,\"conclusion\",\"failure\"),\n+                                  (2,\"event\",\"push\"),(3,\"base\",\"9\"*40),\n+                                  (4,\"external_state_changed\",True),(4,\"package_count\",5)]:\n+            with self.subTest(index=index, key=key):\n+                facts = self.fixture();facts[index][key] = value\n+                with self.assertRaises(AssertionError): a.validate(*facts)\n+\n+    def test_other_package_missing_row_or_ref_cannot_mint_receipt(self):\n+        for key, value in [(\"candidate_ref\",\"9\"*40),(\"version\",\"0.9.0\"),(\"payload_digest\",\"bad\"),(\"package\",\"other\")]:\n+            with self.subTest(key=key):\n+                facts=self.fixture(); facts[5][4][key]=value\n+                with self.assertRaises(AssertionError): a.validate(*facts)\n+        facts=self.fixture();facts[5].pop()\n+        with self.assertRaises(AssertionError): a.validate(*facts)\n+\n+    def test_canonical_source_bytes_match_release_guard_projection(self):\n+        value=dict(run_id=100,head_oid=\"a\"*40,conclusion=\"success\")\n+        self.assertEqual(a.canonical(value), '{\"conclusion\":\"success\",\"head_oid\":\"' + \"a\"*40 + '\",\"run_id\":100}')\n+\n+\n+if __name__ == \"__main__\": unittest.main()","raw_url":"https://github.com/szTheory/crosswake/raw/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d/test%2Fsupport%2Fcompanion_attestation_check.py","sha":"9e7267a89aeb9ac15077a89bb992ab709390aa00","status":"added"}],"html_url":"https://github.com/szTheory/crosswake/commit/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","parents":[{"html_url":"https://github.com/szTheory/crosswake/commit/02f0fbc475180214931b5626f7971fab33d0871f","sha":"02f0fbc475180214931b5626f7971fab33d0871f","url":"https://api.github.com/repos/szTheory/crosswake/commits/02f0fbc475180214931b5626f7971fab33d0871f"},{"html_url":"https://github.com/szTheory/crosswake/commit/6da6df6f9ddc0f48614fd99c50decc6dc23387c4","sha":"6da6df6f9ddc0f48614fd99c50decc6dc23387c4","url":"https://api.github.com/repos/szTheory/crosswake/commits/6da6df6f9ddc0f48614fd99c50decc6dc23387c4"}],"sha":"0eff1ab6c8dbad961116c3a1a0dc91937722eb7d","stats":{"additions":822,"deletions":102,"total":924},"url":"https://api.github.com/repos/szTheory/crosswake/commits/0eff1ab6c8dbad961116c3a1a0dc91937722eb7d"}
