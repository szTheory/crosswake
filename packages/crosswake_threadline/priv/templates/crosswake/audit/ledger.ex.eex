defmodule <%= app_module %>.Audit.Ledger do
  @moduledoc """
  Host-owned audit ledger schema for Crosswake threadline events.

  Generated by `mix crosswake.gen.audit` — this file belongs to your application.
  Customize it to add app-specific fields, indexes, or validation logic.

  ## Hash-Chain Advisory

  `row_hash` and `prev_hash` are **advisory** integrity fingerprints. They detect
  accidental data corruption and give operators a consistency signal, but they do
  NOT prevent tampering by a determined adversary with direct database access.
  The real integrity guarantee is the UNIQUE index on `idempotency_key`: duplicate
  event replays are silently dropped (`on_conflict: :nothing`) rather than creating
  phantom duplicate rows.

  ## Telemetry Handler

  Use `attach/2` to subscribe to Crosswake threadline events and persist them:

      <%= app_module %>.Audit.Ledger.attach(repo: <%= app_module %>.Repo)

  The handler catches all write errors and returns `:ok`. A raising handler causes
  `:telemetry` to auto-detach it, producing a silent audit blackout where events fire
  but nothing is persisted. Log errors instead — never propagate them.
  """

  use Ecto.Schema
  import Ecto.Changeset

  require Logger

  @forbidden_keys [
    "email", "phone", "ip_address", "ssn", "name", "first_name", "last_name", "address",
    :email, :phone, :ip_address, :ssn, :name, :first_name, :last_name, :address
  ]

  @threadline_events [
    [:crosswake, :threadline, :request, :start],
    [:crosswake, :threadline, :request, :stop],
    [:crosswake, :threadline, :request, :exception]
  ]

  schema "crosswake_audit_events" do
    field :thread_id, :string
    field :correlation_id, :string
    field :route_id, :string
    field :actor_ref, :string
    field :actor_kind, :string
    field :event_class, :string
    field :event_type, :string
    field :outcome, :string
    field :provenance, Ecto.Enum, values: [:device_claimed, :backend_accepted]
    field :occurred_at, :utc_datetime_usec
    field :recorded_at, :utc_datetime_usec
    field :idempotency_key, :string
    field :metadata, :map
    field :row_hash, :string
    field :prev_hash, :string
  end

  @doc false
  def changeset(ledger, attrs) do
    ledger
    |> cast(attrs, [
      :thread_id,
      :correlation_id,
      :route_id,
      :actor_ref,
      :actor_kind,
      :event_class,
      :event_type,
      :outcome,
      :provenance,
      :occurred_at,
      :recorded_at,
      :idempotency_key,
      :metadata,
      :row_hash,
      :prev_hash
    ])
    |> validate_required([
      :thread_id,
      :correlation_id,
      :route_id,
      :actor_ref,
      :actor_kind,
      :event_class,
      :event_type,
      :outcome,
      :provenance,
      :occurred_at,
      :recorded_at,
      :idempotency_key
    ])
    |> reject_pii_in_metadata()
    |> compute_hashes()
  end

  @doc """
  Attaches this ledger as a `:telemetry` handler for all Crosswake threadline events.

  Options:
  - `:repo` (required) — the Ecto Repo module to persist events.
  - `:handler_id` (optional) — a unique string handler ID. Defaults to a generated value.

  The handler is crash-isolated: write failures are logged and return `:ok`.
  Write failures are caught and logged — the handler NEVER propagates exceptions
  (auto-detach on raise causes silent audit blackout).
  Duplicate events (same `idempotency_key`) are silently skipped via `on_conflict: :nothing`.
  """
  def attach(opts) do
    repo = Keyword.fetch!(opts, :repo)
    handler_id = Keyword.get(opts, :handler_id, "crosswake-audit-ledger-#{System.unique_integer()}")

    :telemetry.attach_many(
      handler_id,
      @threadline_events,
      &__MODULE__.handle_event/4,
      %{repo: repo}
    )
  end

  @doc """
  Telemetry handler — called for each threadline event.

  Wraps the Repo insert in `try/rescue` so write failures never propagate as exceptions.
  A raising telemetry handler is auto-detached by `:telemetry`, causing a silent audit
  blackout. This handler always returns `:ok`.

  Duplicate events (matching `idempotency_key`) are dropped silently via
  `on_conflict: :nothing, conflict_target: :idempotency_key`.
  """
  def handle_event(event_name, measurements, metadata, config) do
    try do
      attrs = %{
        thread_id: metadata[:thread_id],
        correlation_id: metadata[:correlation_id],
        route_id: metadata[:route_id],
        actor_ref: metadata[:actor_ref],
        actor_kind: metadata[:actor_kind] || "request",
        event_class: "threadline",
        event_type: List.last(event_name) |> to_string(),
        outcome: metadata[:outcome] || "ok",
        provenance: metadata[:provenance] || :backend_accepted,
        occurred_at: DateTime.utc_now(),
        recorded_at: DateTime.utc_now(),
        idempotency_key: metadata[:idempotency_key] || "#{metadata[:thread_id]}|#{List.last(event_name)}|#{measurements[:system_time] || measurements[:duration] || 0}",
        metadata: Map.take(metadata, [:source])
      }

      cs = changeset(%__MODULE__{}, attrs)

      config.repo.insert(cs, on_conflict: :nothing, conflict_target: :idempotency_key)
      :ok
    rescue
      e ->
        Logger.error("Crosswake audit write failed for #{inspect(event_name)}: #{inspect(e)}")
        :ok
    end
  end

  @doc """
  Rejects the changeset if forbidden PII keys are found in metadata.
  """
  def reject_pii_in_metadata(changeset) do
    case get_change(changeset, :metadata) do
      nil ->
        changeset
      metadata when is_map(metadata) ->
        found_keys =
          Enum.filter(@forbidden_keys, fn key -> Map.has_key?(metadata, key) end)

        if found_keys == [] do
          changeset
        else
          add_error(changeset, :metadata, "contains forbidden PII keys")
        end
    end
  end

  @doc """
  Computes advisory row_hash and prev_hash.

  These hashes are **advisory** fingerprints for detecting accidental corruption —
  they are NOT tamper-evidence. `idempotency_key` is the real integrity guarantee.
  """
  def compute_hashes(changeset) do
    if changeset.valid? do
      thread_id = get_field(changeset, :thread_id, "")
      actor_ref = get_field(changeset, :actor_ref, "")
      event_class = get_field(changeset, :event_class, "")

      payload = "#{thread_id}|#{actor_ref}|#{event_class}"
      hash = :crypto.hash(:sha256, payload) |> Base.encode16(case: :lower)

      prev = get_field(changeset, :prev_hash) || "genesis"

      changeset
      |> put_change(:row_hash, hash)
      |> put_change(:prev_hash, prev)
    else
      changeset
    end
  end

  @doc """
  Records an audit event standalone.

  WARNING: Audit events should ideally be inserted in the same transaction as the action they describe.
  Consider using `record_in_multi/3` instead.
  """
  def record(attrs) do
    %__MODULE__{}
    |> changeset(attrs)
  end

  @doc """
  Adds an audit event to an existing Ecto.Multi.

  Uses `on_conflict: :nothing, conflict_target: :idempotency_key` so that replaying
  a multi that already succeeded is idempotent — duplicate rows are silently skipped.

  WARNING: It is up to the caller to execute the multi with the host's Repo.
  """
  def record_in_multi(multi, name, attrs) do
    Ecto.Multi.insert(multi, name, changeset(%__MODULE__{}, attrs),
      on_conflict: :nothing,
      conflict_target: :idempotency_key
    )
  end
end
